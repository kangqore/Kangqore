{
  "name": "kangqore-root",
  "version": "1.0.0",
  "description": "Root script runner for Kangqore",
  "scripts": {
    "start": "cd backend && npm start",
    "dev": "cd backend && npm run dev",
    "build": "./build.sh",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "cd desktop && npm run dev",
    "desktop:build:mac": "cd frontend && npm run build && cd ../desktop && npm run build:mac",
    "desktop:build:win": "cd frontend && npm run build && cd ../desktop && npm run build:win",
    "desktop:build:linux": "cd frontend && npm run build && cd ../desktop && npm run build:linux",
    "redirects:generate": "node scripts/generate-redirects.mjs",
    "redirects:check": "node scripts/generate-redirects.mjs --check",
    "test:redirects": "node scripts/test-redirects.mjs",
    "test:redirects:local": "node scripts/test-redirects-local.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "sitemap:check": "node scripts/generate-sitemap.mjs --check",
    "audit:seo-data": "node scripts/audit-seo-data.mjs",
    "audit:legacy-coverage": "node scripts/audit-legacy-coverage.mjs",
    "audit:page-seo": "node scripts/audit-page-seo.mjs",
    "audit:all": "npm run audit:seo-data && npm run audit:legacy-coverage && npm run audit:page-seo"
  }
}
