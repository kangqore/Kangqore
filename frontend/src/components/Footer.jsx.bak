const RotatingAsterisk = () => (
  <svg width="24" height="24" viewBox="0 0 24 24" className="mx-6 text-white/50 animate-[spin_8s_linear_infinite] shrink-0">
    <g stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
      <line x1="12" y1="2" x2="12" y2="22" />
      <line x1="2" y1="12" x2="22" y2="12" />
      <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
      <line x1="4.93" y1="19.07" x2="19.07" y2="4.93" />
      <line x1="8.46" y1="3.54" x2="15.54" y2="20.46" />
      <line x1="3.54" y1="8.46" x2="20.46" y2="15.54" />
      <line x1="3.54" y1="15.54" x2="20.46" y2="8.46" />
      <line x1="8.46" y1="20.46" x2="15.54" y2="3.54" />
