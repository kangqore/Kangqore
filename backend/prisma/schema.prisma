// ═══════════════════════════════════════════════════════════════════════════════
// Phase 6.7 — Executive Simulator
// ═══════════════════════════════════════════════════════════════════════════════

model ExecutiveSimulation {
  id             String   @id @default(cuid())
  prompt         String   // "Hire 10 engineers"
  context        Json?    // snapshot of relevant enterprise state at simulation time
  dimensions     Json     // { revenue, delivery, cash, headcount, risk, ... }
  confidence     Float
