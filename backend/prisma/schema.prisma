// ═══════════════════════════════════════════════════════════════════════════════
// S123 — SOC2 Type II: audit period + evidence collection
// ═══════════════════════════════════════════════════════════════════════════════

model SOC2AuditPeriod {
  id              String   @id @default(cuid())
  label           String                        // e.g. "FY2026 SOC2 Type II"
  auditor         String?                       // Auditing firm name
  periodStart     DateTime
  periodEnd       DateTime
  status          String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | COMPLETE | FAILED
  evidenceCount   Int      @default(0)
  controlsPassed  Int      @default(0)
  controlsFailed  Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  evidence        SOC2Evidence[]

  @@index([status])
  @@map("soc2_audit_periods")
}

model SOC2Evidence {
  id          String   @id @default(cuid())
  periodId    String
  controlId   String                            // CC6.1 | CC7.2 | A1.1 … (SOC2 trust criteria)
  controlName String
  evidenceType String                           // AUDIT_LOG | ACCESS_CONTROL | ENCRYPTION | INCIDENT | POLICY
  description String   @db.Text
  sourceTable String?                           // e.g. "aegis_audit_logs"
  sourceCount Int      @default(0)             // row count at collection time
  collectedAt DateTime @default(now())
  period      SOC2AuditPeriod @relation(fields: [periodId], references: [id])

  // Was a plain @@index — the collect-evidence route's upsert() has always
  // referenced a periodId_controlId compound unique that never existed,
  // so every upsert silently failed (caught by a blanket .catch(() => null)).
  // This is the actual fix; the route code was already written for it.
  @@unique([periodId, controlId])
  @@map("soc2_evidence")
}

