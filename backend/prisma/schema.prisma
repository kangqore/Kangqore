  isDefault  Boolean     @default(false)
  timezone   String      @default("Asia/Kolkata")
  rules      Json
  overrides  Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation("UserAvailability", fields: [userId], references: [id])
  eventTypes EventType[] @relation("AvailabilityScheduleToEventType")

  @@index([userId])
  @@map("availability_schedules")
}

model EventInvitee {
  id          String         @id @default(cuid())
  eventId     String
  name        String
  email       String
  phone       String?
  company     String?
  timezone    String?
  responses   Json?
  smsOptIn    Boolean        @default(false)
  status      InviteeStatus  @default(ACCEPTED)
  viewedAt    DateTime?
  cancelledAt DateTime?
