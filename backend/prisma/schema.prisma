  @@index([leadId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("kimmp_behavior_profiles")
}

// ---------------------------------------------------------------------------
// KIMMP Page Factory — generated website pages (PR-A1).
// Pages are stored as structured data and rendered by one dynamic renderer.
// Publishing is admin-gated: a page is DRAFT until an admin publishes it.
// ---------------------------------------------------------------------------
model KimmpGeneratedPage {
  id             String    @id @default(uuid())
  slug           String    @unique
  route          String    @unique
  pageType       String
  title          String
  status         String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  department     String?
  primaryService String?
  contentJson    Json // hero, sections, seo, schema, internalLinks
  version        Int       @default(1)
  createdBy      String?
  publishedAt    DateTime?
  publishedBy    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([pageType])
  @@map("kimmp_generated_pages")
}

// ---------------------------------------------------------------------------
// KIMMP Page Factory — detected missing-page opportunities (PR-B).
// A recurring visitor question with no dedicated page becomes an OPEN
// opportunity for an admin to review. KIMMP never auto-creates pages.
// ---------------------------------------------------------------------------
model KimmpPageOpportunity {
  id             String   @id @default(uuid())
  title          String
  suggestedSlug  String   @unique
  pageType       String   @default("faq")
  sourceModule   String   @default("eqore")
  sourceReason   String
  sampleQuestion String?
  signalCount    Int      @default(1)
  priority       Int      @default(1)
  priorityLabel  String   @default("Single mention")
  status         String   @default("OPEN") // OPEN | DISMISSED | CONVERTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@map("kimmp_page_opportunities")
}

// ---------------------------------------------------------------------------
// KIMMP Page Factory — page lifecycle audit trail (PR-D).
// Every create / publish / unpublish is recorded: who did what, when.
// ---------------------------------------------------------------------------
model KimmpPageAudit {
  id        String   @id @default(uuid())
  pageId    String?
  slug      String
  action    String // CREATED | GENERATED | PUBLISHED | UNPUBLISHED
  actor     String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([createdAt])
  @@map("kimmp_page_audit")
}

// ---------------------------------------------------------------------------
// KIMMP Signal Ledger (Phase 1) — the one hub every system writes signals to
// and KIMMP reads from. Replaces ad-hoc point-to-point wiring with a backbone.
// ---------------------------------------------------------------------------
model KimmpSignal {
  id             String   @id @default(uuid())
  sourceModule   String // eqore | lead-intelligence | alis | vis | kimmp
  signalType     String
  signalCategory String // BEHAVIOR | INTENT | MARKET | CONTENT | RISK | SYSTEM
  signalValue    String
  confidence     Float    @default(0)
  severity       String   @default("LOW") // LOW | MODERATE | HIGH | CRITICAL
  conversationId String?
  leadId         String?
  sessionId      String?
  metadata       Json?
  status         String   @default("NEW") // NEW | PROCESSED | DISMISSED
  createdAt      DateTime @default(now())

  @@index([sourceModule])
  @@index([signalCategory])
  @@index([status])
  @@index([createdAt])
  @@map("kimmp_signals")
}

// ---------------------------------------------------------------------------
// KIMMP Decision Engine (Phase 3) — proposed next-best actions derived from
// signals. KIMMP decides and RECOMMENDS; it does not auto-execute. A decision
// is PROPOSED until an admin approves it.
// ---------------------------------------------------------------------------
model KimmpDecision {
  id                String    @id @default(uuid())
  signalId          String?
  decisionType      String // RESPONSE_POLICY | SALES_ALERT | CONTENT_OPPORTUNITY | MARKET_ALERT | HUMAN_HANDOFF
  recommendedAction String
  targetModule      String // eqore | lead-intelligence | alis | vis | human
  reasoning         String
  confidence        Float     @default(0)
  priority          Int       @default(1)
  status            String    @default("PROPOSED") // PROPOSED | APPROVED | EXECUTED | DISMISSED
  conversationId    String?
  leadId            String?
  // Phase 4 governance columns
  approvedBy        String? // admin userId who approved
  approvedAt        DateTime?
  dismissedBy       String? // admin userId who dismissed
  dismissedAt       DateTime?
  executedBy        String? // admin userId who marked executed (Phase 3 workflow)
  executedAt        DateTime?
  notes             String? // human notes on the approval/dismissal decision
  // Phase 6.4 — outcome tracking + recommendation lifecycle state machine
  outcome               String?
  outcomeAt             DateTime?
  outcomeBy             String?
  recommendationState   String   @default("GENERATED")
  // GENERATED → REVIEWED → ACCEPTED → EXECUTED → OBSERVED → VALIDATED → LEARNED
  reviewedAt            DateTime?
  validatedAt           DateTime?
  learnedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([targetModule])
  @@index([createdAt])
  @@map("kimmp_decisions")
}

// ---------------------------------------------------------------------------
// KIMMP Governance — Audit Log (Phase 4)
// Immutable record of every governance action taken on KIMMP artefacts.
// ---------------------------------------------------------------------------
model KimmpAuditEntry {
  id         String   @id @default(uuid())
  actor      String // admin userId (or "SYSTEM" for automated actions)
  action     String // DECISION_APPROVED | DECISION_DISMISSED | DECISION_EXECUTED | SIGNAL_DISMISSED | ENGINE_RUN | COST_RECORDED
  targetType String // decision | signal | engine | cost
  targetId   String? // ID of the artefact acted on
  notes      String? // admin-supplied reason or context
  metadata   Json? // structured context snapshot
  createdAt  DateTime @default(now())

  @@index([actor])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("kimmp_audit_entries")
}

// ---------------------------------------------------------------------------
// KIMMP Governance — LLM Cost Ledger (Phase 4)
// Tracks per-call token usage and estimated USD cost for every Claude API call
// KIMMP makes. Enables the admin dashboard to show spend and detect runaway cost.
// ---------------------------------------------------------------------------
model KimmpLlmCost {
  id               String   @id @default(uuid())
  operation        String // BEHAVIOR_TIER2 | PAGE_GENERATION | CLAIM_VALIDATION
  model            String // e.g. claude-haiku-4-5-20251001
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  estimatedCostUsd Float    @default(0)
  conversationId   String?
  leadId           String?
  pageId           String?
  createdAt        DateTime @default(now())

  @@index([operation])
  @@index([createdAt])
  @@map("kimmp_llm_costs")
}

// ---------------------------------------------------------------------------
// S308 — KIMMP Intelligence Gateway: unified LLM call log.
// Reality check: three per-call cost ledgers already exist in this schema —
// KimmpLlmCost (above), AICostEntry, and WaandaRuntimeCall — and all three
// are effectively dead: zero writes in production code paths (WaandaRuntimeCall
// is only reachable via a nightly benchmark script). Rather than add a fourth
// unused table, this is the one that's actually wired into the real call paths
// (kimmpLLMRouter.routedCall, withWaandax, AEGIS callLLM). The three legacy
// ledgers are left in place (dropping tables isn't in scope here) but should
// be considered for retirement in a future cleanup sprint.
// ---------------------------------------------------------------------------
model LlmCallLog {
  id                 String   @id @default(cuid())
  userId             String?
  actorType          String   // KIMMP | AEGIS | HUMAN | COPILOT | NOTEBOOK
  model              String
  provider           String   // claude | waandax | gen2 | openai | gemini | none
  promptTokens       Int      @default(0)
  completionTokens   Int      @default(0)
  totalCost          Float    @default(0)
  latencyMs          Int      @default(0)
  prompt             String   @db.Text  // truncated to 2000 chars before storage
  response           String   @db.Text  // truncated to 2000 chars before storage
  referencedObjectIds String[] @default([])
  toolExecutionIds   String[] @default([]) // S315 — ActionExecution ids for any OntologyAction invoked as a tool call during this LLM call
  taskType           String?
  agentRole          String?
  sourceModule       String?  // best-effort file attribution for passively-instrumented call sites
  promptName         String?  // S311 — AIPrompt.name, when the caller resolved its system prompt via PromptRegistry
  promptVersion      Int?     // AIPrompt.version actually served — null if promptName given but registry lookup missed
  status             String   // SUCCESS | ERROR | BLOCKED
  errorMessage       String?
  piiDetected        Boolean  @default(false)
  piiPatterns        String[] @default([])
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([actorType])
  @@index([createdAt])
  @@index([status])
  @@index([promptName])
  @@map("llm_call_logs")
}

// S309 — per-user/team monthly token budget. Usage is computed on the fly by
// summing LlmCallLog rows for the current calendar month rather than kept in
// a separate running counter — correct by construction, and "auto-resets
// monthly" falls out for free from the createdAt filter.
model TokenBudget {
  id                String   @id @default(cuid())
  userId            String?
  teamId            String?
  monthlyTokenLimit Int
  alertThreshold    Float    @default(0.8)
  hardStop          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([teamId])
  @@map("token_budgets")
}

// S309 — per-deployment PII scanning policy. Only one row should be `active`
// at a time (enforced in the service layer, not the DB) — deployments switch
// profiles (default/healthcare/financial) by flipping which row is active.
model PiiScanConfig {
  id              String   @id @default(cuid())
  name            String   @unique // default | healthcare | financial | ...
  mode            String   @default("AUDIT") // REDACT | BLOCK | AUDIT
  enabledPatterns String[] @default(["email", "phone", "ni_number", "ssn", "nhs_number", "iban"]) // 'passport' available but not default — no universal format, high false-positive rate
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pii_scan_configs")
}

// ---------------------------------------------------------------------------
// KIMMP Phase 5 — Prediction Ledger
// Records every prediction run so outputs can be compared against real
// outcomes as data accumulates. This IS the ML training label store — each
// row is a (features, prediction, actualOutcome?) pair for future model builds.
// ---------------------------------------------------------------------------
model KimmpPrediction {
  id                    String   @id @default(uuid())
  leadId                String
  // v0 outputs (rules-based; replaced by ML models post-launch)
  conversionProbability Float    @default(0) // 0.0–1.0
  acvEstimate           Float    @default(0) // USD
  deliveryRisk          String   @default("LOW") // LOW | MODERATE | HIGH
  modelVersion          String   @default("v0-rules")
  // Feature snapshot at prediction time (for future model training)
  features              Json?
  // Outcome — filled in post-conversion for training labels
  actualConverted       Boolean?
  actualAcv             Float?
  actualDeliveryIssue   Boolean?
  createdAt             DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("kimmp_predictions")
}

