  updatedAt   DateTime @updatedAt
  client      User     @relation(fields: [clientId], references: [id])

  @@map("resource_links")
}

model Message {
  id                      String          @id @default(cuid())
  content                 String
  senderId                String
  receiverId              String?
  channelId               String?
  isRead                  Boolean         @default(false)
  createdAt               DateTime        @default(now())
