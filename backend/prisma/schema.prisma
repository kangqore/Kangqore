model HcipEngineVersion {
  id               String   @id @default(cuid())
  engineVersion    String   @unique
  reasoningVersion String
  decisionVersion  String
  schemaVersion    String
  releasedAt       DateTime @default(now())
  releasedBy       String
  notes            String?  @db.Text

