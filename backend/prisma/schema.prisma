model AccountabilityEvent {
  id String @id @default(cuid())

  // Event Classification
  eventType     String // DECISION_APPROVED | RISK_ACCEPTED | CHANGE_AUTHORIZED | DELIVERABLE_SIGNED
  eventCategory String // COMMITMENT | ESCALATION | WITHDRAWAL

  // NEW: Enhanced Classification
  eventSource EventSource? // DASHBOARD | EMAIL | SYSTEM_RULE | API | ADMIN_OVERRIDE
  actorRole   ActorRole? // ADMIN | CLIENT | SYSTEM | PARTNER

  // Core References
  projectId String
  clientId  String
  userId    String // Person who committed

  // DEPRECATED: Specific entity FKs (keep for backward compat)
  decisionId      String?
  riskId          String?
  changeRequestId String?
  deliverableId   String?

  // NEW: Polymorphic Entity Link (preferred)
  relatedEntityType RelatedEntityType? // DECISION | RISK | CHANGE_REQUEST | etc.
  relatedEntityId   String?

  // Event Metadata
  actionTaken    String // "Approved", "Accepted", "Rejected", "Escalated" [DEPRECATED]
  impactSummary  String? // e.g., "+2 weeks, +$5k, Risk: High" [DEPRECATED]
  commitmentNote String? // User-provided note/signature
  ipAddress      String? // Audit trail

  // NEW: Rich Summary
  summary String? // Narrative description (replaces actionTaken + impactSummary)

  // Timestamps
  eventTimestamp DateTime @default(now())

  // Relations
  project       Project        @relation(fields: [projectId], references: [id])
  client        User           @relation("ClientAccountability", fields: [clientId], references: [id])
  user          User           @relation("UserAccountability", fields: [userId], references: [id])
  decision      Decision?      @relation(fields: [decisionId], references: [id])
  risk          Risk?          @relation(fields: [riskId], references: [id])
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  deliverable   Deliverable?   @relation(fields: [deliverableId], references: [id])

  // NEW: Canonical relations
  obligations AccountabilityObligation[] @relation("EventObligations")
  impacts     AccountabilityImpact[]     @relation("EventImpacts")

  @@index([projectId, eventTimestamp])
  @@index([clientId, eventTimestamp])
  @@index([eventType])
  @@map("accountability_events")
}

// ============================================
// CANONICAL ACCOUNTABILITY TABLES
// ============================================

model AccountabilityObligation {
  id        String @id @default(cuid())
  clientId  String
  projectId String

  obligationType ObligationType // APPROVAL_REQUIRED | ACCESS_REQUIRED | etc.
  owedByRole     ActorRole // CLIENT | ADMIN | PARTNER
  owedByUserId   String?

  description String
  dueDate     DateTime?
  status      ObligationStatus @default(OPEN) // OPEN | FULFILLED | OVERDUE

  linkedEventId String // FK to AccountabilityEvent
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  // Relations
  client      User                @relation("ClientObligations", fields: [clientId], references: [id])
  project     Project             @relation("ProjectObligations", fields: [projectId], references: [id])
  linkedEvent AccountabilityEvent @relation("EventObligations", fields: [linkedEventId], references: [id])
  owedByUser  User?               @relation("UserObligations", fields: [owedByUserId], references: [id])

  @@index([clientId, status])
  @@index([projectId, status])
  @@index([owedByRole, status])
  @@index([linkedEventId])
  @@map("accountability_obligations")
}

model AccountabilityImpact {
  id      String @id @default(cuid())
  eventId String // FK to AccountabilityEvent

  impactType  ImpactType // DELAY_DAYS | COST_INCREASE | RISK_SCORE | SCOPE_EXPANSION
  impactValue Decimal    @db.Decimal(12, 2)
  impactUnit  ImpactUnit // DAYS | INR | USD | SCORE | PERCENT

  appliedTo ImpactDomain // TIMELINE | BUDGET | RISK | QUALITY
  createdAt DateTime     @default(now())

  // Relations
  event AccountabilityEvent @relation("EventImpacts", fields: [eventId], references: [id])

  @@index([eventId])
  @@index([appliedTo])
  @@map("accountability_impacts")
}

model AccountabilitySnapshot {
  id           String   @id @default(cuid())
  clientId     String
  projectId    String
  snapshotDate DateTime @db.Date

  // Delay Attribution
  clientDelayDays   Int @default(0)
  adminDelayDays    Int @default(0)
  externalDelayDays Int @default(0)

  // Budget Attribution
  budgetClientCaused Decimal @default(0) @db.Decimal(12, 2)
  budgetAdminCaused  Decimal @default(0) @db.Decimal(12, 2)

  // Risk
  riskScore Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  // Relations
  client  User    @relation("ClientSnapshots", fields: [clientId], references: [id])
  project Project @relation("ProjectSnapshots", fields: [projectId], references: [id])

  @@unique([projectId, snapshotDate])
  @@index([clientId, snapshotDate])
  @@map("accountability_snapshots")
}

