  clientId                String?
  createdAt               DateTime        @default(now())
  investorId              String?
  partnerId               String?
  attachments             Json?
  direction               String?
  isRead                  Boolean         @default(false)
  replyToId               String?
  threadId                String?
  jobSeekerId             String?
  adminFolder             String?         @default("INBOX")
  adminLabels             Json?
  clientFolder            String?         @default("INBOX")
  clientLabels            Json?
  investorFolder          String?         @default("INBOX")
  investorLabels          Json?
  isAdminImportant        Boolean         @default(false)
  isAdminStarred          Boolean         @default(false)
  isClientImportant       Boolean         @default(false)
  isClientStarred         Boolean         @default(false)
  isInvestorImportant     Boolean         @default(false)
  isInvestorStarred       Boolean         @default(false)
  isJobSeekerImportant    Boolean         @default(false)
  isJobSeekerStarred      Boolean         @default(false)
  isPartnerImportant      Boolean         @default(false)
  isPartnerStarred        Boolean         @default(false)
  jobSeekerFolder         String?         @default("INBOX")
