model KangqoreVisPageBlueprint {
  id                String                     @id @default(cuid())
  pageName          String
  url               String                     @unique
  pageType          KangqoreVisPageType        @default(OTHER)
  primaryKeyword    String?
  secondaryKeywords String[]
  targetBuyer       String?
  searchIntent      KangqoreVisSearchIntent?
  aiIntent          String?
  problemSolved     String?                    @db.Text
  businessOutcome   String?                    @db.Text
  parentHubId       String?
  proofRequired     String?                    @db.Text
  faqRequired       Boolean                    @default(false)
  schemaRequired    KangqoreVisSchemaKind[]
  ctaKind           KangqoreVisCtaKind         @default(NONE)
  conversionGoal    String?
  metaTitle         String?
  metaDescription   String?                    @db.Text
  ogImage           String?
  status            KangqoreVisBlueprintStatus @default(DRAFT)
  source            String?                    @default("manual")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  parentHub        KangqoreVisHub?              @relation("HubBlueprints", fields: [parentHubId], references: [id])
  spokes           KangqoreVisSpoke[]           @relation("BlueprintSpokes")
  schemas          KangqoreVisSchemaRecord[]
  internalLinksOut KangqoreVisInternalLink[]    @relation("LinkSource")
  internalLinksIn  KangqoreVisInternalLink[]    @relation("LinkTarget")
  keywords         KangqoreVisKeyword[]
  audits           KangqoreVisAudit[]
  governanceChecks KangqoreVisGovernanceCheck[]
  cwvSamples       KangqoreVisCwvSample[]
  faqs             KangqoreVisFAQ[]             @relation("BlueprintFAQs")

  @@index([pageType])
  @@index([status])
  @@map("kangqore_vis_page_blueprints")
}

model KangqoreVisHub {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  category    String?
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spokes     KangqoreVisSpoke[]
  blueprints KangqoreVisPageBlueprint[] @relation("HubBlueprints")

  @@map("kangqore_vis_hubs")
}

model KangqoreVisSpoke {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  hubId       String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hub        KangqoreVisHub             @relation(fields: [hubId], references: [id], onDelete: Cascade)
  blueprints KangqoreVisPageBlueprint[] @relation("BlueprintSpokes")

  @@index([hubId])
  @@map("kangqore_vis_spokes")
}

model KangqoreVisEntity {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String?                @db.Text
  category    String?
  url         String?
  schemaType  KangqoreVisSchemaKind?
  sameAs      String[]
  proofPoints String[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  fromRels KangqoreVisEntityRelation[] @relation("EntityFrom")
  toRels   KangqoreVisEntityRelation[] @relation("EntityTo")

  @@index([category])
  @@map("kangqore_vis_entities")
}

model KangqoreVisEntityRelation {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  kind      String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())

  from KangqoreVisEntity @relation("EntityFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   KangqoreVisEntity @relation("EntityTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId])
  @@map("kangqore_vis_entity_relations")
}

model KangqoreVisFAQCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  faqs KangqoreVisFAQ[]

  @@map("kangqore_vis_faq_categories")
}

model KangqoreVisFAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  categoryId  String?
  blueprintId String?
  source      String?  @default("manual")
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  KangqoreVisFAQCategory?   @relation(fields: [categoryId], references: [id])
  blueprint KangqoreVisPageBlueprint? @relation("BlueprintFAQs", fields: [blueprintId], references: [id])

  @@index([categoryId])
  @@index([blueprintId])
  @@map("kangqore_vis_faqs")
}

model KangqoreVisSchemaRecord {
  id            String                @id @default(cuid())
  blueprintId   String
  schemaKind    KangqoreVisSchemaKind
  jsonLd        Json
  contentHash   String?
  isValid       Boolean               @default(true)
  lastAuditedAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  blueprint KangqoreVisPageBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, schemaKind])
  @@map("kangqore_vis_schema_records")
}

model KangqoreVisInternalLink {
  id         String   @id @default(cuid())
  sourceId   String
  targetId   String
  anchorText String?
  position   String?
  createdAt  DateTime @default(now())

  source KangqoreVisPageBlueprint @relation("LinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target KangqoreVisPageBlueprint @relation("LinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, anchorText])
  @@index([targetId])
  @@map("kangqore_vis_internal_links")
}

model KangqoreVisKeyword {
  id             String   @id @default(cuid())
  term           String
  isPrimary      Boolean  @default(false)
  blueprintId    String?
  searchVolume   Int?
  difficulty     Int?
  rankingHistory Json?
