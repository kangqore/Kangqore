  fieldAccess Json     @default("{}")          // { modelName: [allowedFields] }
  deptScope   Json     @default("[]")          // Array of department names
  isSystem    Boolean  @default(false)
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([customerId])
  @@map("custom_roles")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S188 — Enterprise Blueprint Templates
// ═══════════════════════════════════════════════════════════════════════════════

model EnterpriseBlueprintTemplate {
  id          String   @id @default(cuid())
  name        String
  useCase     String
  industry    String?
  description String?  @db.Text
  modules     Json     @default("[]")
  config      Json     @default("{}")
  isPublished Boolean  @default(false)
  deployCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([useCase])
  @@index([isPublished])
  @@map("enterprise_blueprint_templates")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S189 — Digital Contract Suite
// ═══════════════════════════════════════════════════════════════════════════════

model DigitalContract {
  id             String    @id @default(cuid())
  customerId     String
  type           String                         // MSA | ORDER_FORM | DPA | NDA | SOW
  version        String    @default("1.0")
  status         String    @default("DRAFT")    // DRAFT | PENDING_SIGN | SIGNED | EXPIRED | RENEWED
  clauses        Json      @default("[]")       // Array of { id, title, body, category }
  signatoryName  String?
  signatoryEmail String?
  signedAt       DateTime?
  expiresAt      DateTime?
  renewalDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([customerId])
  @@index([type, status])
  @@map("digital_contracts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S191–S198 — BIDS™ Commercial Track (scoring engine models)
// ═══════════════════════════════════════════════════════════════════════════════

model BidsScoringEngagement {
  id                   String    @id @default(cuid())
  customerId           String
  customerName         String
  title                String
  tier                 String    @default("STANDARD")  // ENTERPRISE | STANDARD | SMB
  verticalPack         String    @default("STANDARD")  // STANDARD | ARIA | LEX | FINX
  oemPartnerId         String?
  oemPartnerName       String?
  status               String    @default("ACTIVE")    // ACTIVE | COMPLETED | PAUSED | CANCELLED
  overallScore         Float?
  scoreGrade           String?
  convertedToBlueprint Boolean   @default(false)
  conversionDate       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?
  scores               BidsScoringPillar[]
  deliverables         BidsScoringDeliverable[]
  @@index([customerId])
  @@index([status])
  @@index([verticalPack])
  @@map("bids_scoring_engagements")
}

model BidsScoringPillar {
  id               String                @id @default(cuid())
  engagementId     String
  engagement       BidsScoringEngagement @relation(fields: [engagementId], references: [id])
  pillarName       String
  pillarCategory   String
  pillarIndex      Int
  score            Float
  weight           Float
  weightedScore    Float
  waandaEvaluation String?
  evidence         String?
  recommendation   String?
  createdAt        DateTime @default(now())
  @@index([engagementId])
  @@map("bids_scoring_pillars")
}

model BidsScoringDeliverable {
  id           String                @id @default(cuid())
  engagementId String
  engagement   BidsScoringEngagement @relation(fields: [engagementId], references: [id])
  type         String
  label        String
  status       String   @default("PENDING")  // PENDING | GENERATING | COMPLETE
  content      Json?
  generatedAt  DateTime?
  createdAt    DateTime @default(now())
  @@index([engagementId])
  @@index([type, status])
  @@map("bids_scoring_deliverables")
}

model BidsSmbScan {
  id            String   @id @default(cuid())
  companyName   String
  industry      String
  contactName   String
  contactEmail  String
  revenueRange  String?
  employeeRange String?
  topChallenge  String?
  answers       Json     @default("{}")
  status        String   @default("SUBMITTED")  // SUBMITTED | PROCESSING | COMPLETE
  scoreJson     Json?
  paidAt        DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([status])
  @@map("bids_smb_scans")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S199–S207 — Gen5 Foundation (WAANDA Cognitive Engine)
// ═══════════════════════════════════════════════════════════════════════════════

model Gen5CorpusRecord {
  id         String   @id @default(cuid())
  domain     String   // Finance | PMO | CRM | HR | Strategy
  decisionId String?
  prompt     String   @db.Text
  completion String   @db.Text
  quality    Float    @default(0.8)
  tier       String   @default("STANDARD") // STANDARD | HIGH | SYNTHETIC
  included   Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@index([domain])
  @@index([quality])
  @@index([tier])
  @@map("gen5_corpus_records")
}

model Gen5SyntheticPair {
  id         String   @id @default(cuid())
  sourceType String   // reasoning_trace | debate | decision
  sourceId   String?
  prompt     String   @db.Text
  completion String   @db.Text
  quality    Float    @default(0.85)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([sourceType])
  @@index([approved])
  @@map("gen5_synthetic_pairs")
}

model Gen5TrainingRun {
  id             String    @id @default(cuid())
  runLabel       String
  baseModel      String    @default("Mistral-22B")
  adapterType    String    @default("LoRA+QLoRA")
  corpusSize     Int       @default(0)
  syntheticSize  Int       @default(0)
  epochs         Int       @default(3)
  finalLoss      Float?
  status         String    @default("PENDING") // PENDING | RUNNING | COMPLETE | FAILED
  checkpointPath String?
  costGbp        Float?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  @@index([status])
  @@map("gen5_training_runs")
}

model Gen5EvalResult {
  id              String   @id @default(cuid())
  runLabel        String
  decisionCount   Int      @default(1000)
  gen5Accuracy    Float
  gen4Accuracy    Float
  claudeAccuracy  Float
  gen5Latency     Float
  gen4Latency     Float
  claudeLatency   Float
  gen5Cost        Float
  gen4Cost        Float
  coherenceScore  Float
  routingPct      Float    @default(0)
  status          String   @default("COMPLETE")
  createdAt       DateTime @default(now())
  @@index([createdAt])
  @@map("gen5_eval_results")
}

model Gen5RouterConfig {
  id          String   @id @default(cuid())
  gen5Pct     Float    @default(0)
  gen4Pct     Float    @default(80)
  claudePct   Float    @default(20)
  shadowMode  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  @@map("gen5_router_configs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Overshadow Roadmap P5 — Proof Points & Analyst Validation.
//
// None of these three models represent a completed outcome — they're the
// tracking infrastructure for real-world processes (customer-permission
// conversations, publishing real BIDS results, analyst relationships) that
// only a human can actually run. Every row starts at its earliest honest
// stage; nothing here is pre-populated demo data.
// ═══════════════════════════════════════════════════════════════════════════════

model ReferenceCustomerCandidate {
  id             String    @id @default(cuid())
  customerName   String
  contactName    String?
  contactEmail   String?
  stage          String    @default("IDENTIFIED") // IDENTIFIED | OUTREACH | PERMISSION_REQUESTED | PERMISSION_GRANTED | PUBLISHED | DECLINED
  outcomeSummary String?   @db.Text  // real, measurable result — filled in once known, never guessed
  notes          String?   @db.Text
  ownerUserId    String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage])
  @@map("reference_customer_candidates")
}

model AnalystRelationship {
  id             String    @id @default(cuid())
  firm           String    // Gartner | Forrester | IDC | ...
  analystName    String?
  category       String?   // e.g. "low-code / agent-building", "ITSM"
  status         String    @default("NOT_CONTACTED") // NOT_CONTACTED | OUTREACH_SENT | BRIEFED | ONGOING
  lastBriefingAt DateTime?
  nextFollowUpAt DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@map("analyst_relationships")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Overshadow Roadmap P6 — The Partner Ecosystem.
//
// PartnerTier defines the program structure — certification requirements,
// revenue-share economics, enablement materials — the "structural
// prerequisite before any real SI conversation can close" per P6.1. It ships
// with zero seeded rows: revenue-share percentages and certification bars
// are real business terms only Kangqore's own leadership can set, not
// something this code invents on their behalf. PartnerRelationship tracks
// real SI conversations against those tiers once they exist, same honest
// empty-by-default discipline as P5's GTM pipeline.
// ═══════════════════════════════════════════════════════════════════════════════

model PartnerTier {
  id                       String    @id @default(cuid())
  name                     String    @unique
  description              String?   @db.Text
  certificationRequirements String?  @db.Text
  revenueSharePct          Float?
  enablementMaterialsNote  String?   @db.Text
  status                   String    @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  relationships PartnerRelationship[]

  @@map("partner_tiers")
}

model PartnerRelationship {
  id            String       @id @default(cuid())
  firmName      String
  practiceArea  String?      // e.g. "ServiceNow-adjacent", "AI-transformation"
  tierId        String?
  tier          PartnerTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  contactName   String?
  contactEmail  String?
  stage         String       @default("IDENTIFIED") // IDENTIFIED | OUTREACH | NDA_SENT | TERMS_AGREED | CERTIFIED | ACTIVE | DECLINED
  notes         String?      @db.Text
  activatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([stage])
  @@map("partner_relationships")
}

model BidsProofPointPublication {
  id            String    @id @default(cuid())
  engagementId  String                          // real BidsScoringEngagement.id — never a fabricated one
  publicLabel   String                          // e.g. "Mid-market logistics firm" if anonymized
  anonymized    Boolean   @default(true)
  baselineNote  String?   @db.Text              // free-text pre-engagement baseline, only if the team actually has one
  status        String    @default("DRAFT")     // DRAFT | PUBLISHED
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@map("bids_proof_point_publications")
}
