// ═══════════════════════════════════════════════════════════════════════════════
// Phase 6.4 — Enterprise Cognition Layer
// Constitutional Invariant 6: append-only, forward-only, event-sourced.
// ═══════════════════════════════════════════════════════════════════════════════

// Immutable audit log of every inter-engine event (replay substrate)
model CognitionEvent {
  id           String   @id @default(cuid())
  type         String
  // evidence_created | observation_created | lesson_created | insight_created
  // pattern_created | principle_candidate | principle_created
  // playbook_candidate | playbook_created | policy_created
  artifactId   String
  artifactType String
  domain       String
  payload      Json     // full artifact snapshot at emission time — enables replay
  emittedAt    DateTime @default(now())

  @@index([type, domain])
  @@index([emittedAt])
  @@map("cognition_events")
}

// Level 0 — Immutable facts. No LLM. No interpretation. Ever.
model EnterpriseEvidence {
  id           String   @id @default(cuid())
  source       String   // 'decision' | 'mission' | 'simulation' | 'feedback' | 'signal'
  sourceId     String?
  decisionId   String?
  missionId    String?
  objectiveId  String?
  domain       String
  tier         String   // STRATEGIC | CRITICAL | OPERATIONAL
  rawData      Json     // verbatim captured data, immutable
  createdAt    DateTime @default(now())

  observations EnterpriseObservation[]

  @@index([domain, source])
  @@index([createdAt])
  @@map("enterprise_evidence")
}

// Level 1 — Interpretation of one evidence artifact
model EnterpriseObservation {
  id               String   @id @default(cuid())
  evidenceId       String
  domain           String
  tier             String
  whatHappened     String
  whyItHappened    String
  confidence       Float
  evidenceCount    Int      @default(1)
  lastValidated    DateTime?
  validationWindow Int?
  tags             String[]
  createdAt        DateTime @default(now())

  evidence         EnterpriseEvidence @relation(fields: [evidenceId], references: [id])
  lessons          EnterpriseLesson[]

  @@index([domain])
  @@map("enterprise_observations")
}

// Level 2 — What one situation taught us
model EnterpriseLesson {
  id               String    @id @default(cuid())
  observationId    String?
  domain           String
  tier             String
  lesson           String
  policyChange     String?
  confidence       Float
  evidenceCount    Int       @default(1)
  lastValidated    DateTime?
  validationWindow Int?
  tags             String[]
  promotedAt       DateTime?
  createdAt        DateTime  @default(now())

  observation      EnterpriseObservation? @relation(fields: [observationId], references: [id])
  insights         EnterpriseLessonInsight[]
  evolutions       PolicyEvolution[]

  @@index([domain])
  @@map("enterprise_lessons")
}

// Level 3 — What multiple lessons collectively suggest
model EnterpriseInsight {
  id               String    @id @default(cuid())
  domain           String
  insight          String
  confidence       Float
  evidenceCount    Int       @default(1)
  lastValidated    DateTime?
  validationWindow Int?
  tags             String[]
  promotedAt       DateTime?
  createdAt        DateTime  @default(now())

  lessons          EnterpriseLessonInsight[]
  patterns         EnterpriseInsightPattern[]

  @@index([domain])
  @@map("enterprise_insights")
}

model EnterpriseLessonInsight {
  lessonId  String
  insightId String
  lesson    EnterpriseLesson  @relation(fields: [lessonId],  references: [id])
  insight   EnterpriseInsight @relation(fields: [insightId], references: [id])
  @@id([lessonId, insightId])
  @@map("enterprise_lesson_insights")
}

// Level 4 — Measurable repetition across insights
model EnterprisePattern {
  id               String    @id @default(cuid())
  domain           String
  description      String
  frequency        Int       @default(1)
  confidence       Float
  evidenceCount    Int       @default(1)
  lastValidated    DateTime?
  validationWindow Int?
  tags             String[]
  promotedAt       DateTime?
  createdAt        DateTime  @default(now())

  insights         EnterpriseInsightPattern[]
  principles       EnterprisePrinciplePattern[]

  @@index([domain])
  @@map("enterprise_patterns")
}

model EnterpriseInsightPattern {
  insightId String
  patternId String
  insight   EnterpriseInsight @relation(fields: [insightId], references: [id])
  pattern   EnterprisePattern @relation(fields: [patternId], references: [id])
  @@id([insightId, patternId])
  @@map("enterprise_insight_patterns")
}

// Level 5 — Enterprise rule. Versioned. Promotable.
model EnterprisePrinciple {
  id               String    @id @default(cuid())
  domain           String
  statement        String
  rationale        String
  confidence       Float
  evidenceCount    Int       @default(1)
  lastValidated    DateTime?
  validationWindow Int?
  version          Int       @default(1)
  status           String    @default("ACTIVE") // ACTIVE | SUPERSEDED | DEPRECATED
  promotionStatus  String    @default("APPROVED") // CANDIDATE | APPROVED | REJECTED | SUPERSEDED
  promotionMode    String    @default("BOOTSTRAP") // BOOTSTRAP | GOVERNED
  supersedes       String?
  supersededBy     String?
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  promotedAt       DateTime?
  createdAt        DateTime  @default(now())

  patterns         EnterprisePrinciplePattern[]
  playbooks        EnterprisePlaybookPrinciple[]
  evolutions       PolicyEvolution[]

  @@index([domain, status])
  @@map("enterprise_principles")
}

model EnterprisePrinciplePattern {
  principleId String
  patternId   String
  principle   EnterprisePrinciple @relation(fields: [principleId], references: [id])
  pattern     EnterprisePattern   @relation(fields: [patternId],   references: [id])
  @@id([principleId, patternId])
  @@map("enterprise_principle_patterns")
}

// Level 6 — Operationalized principles. Versioned.
model EnterprisePlaybook {
  id               String    @id @default(cuid())
  domain           String
  title            String
  steps            Json
  confidence       Float
  evidenceCount    Int       @default(1)
  lastValidated    DateTime?
  validationWindow Int?
  version          Int       @default(1)
  status           String    @default("ACTIVE")
  promotionStatus  String    @default("APPROVED")
  promotionMode    String    @default("BOOTSTRAP")
  supersedes       String?
  supersededBy     String?
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  promotedAt       DateTime?
  createdAt        DateTime  @default(now())

  principles       EnterprisePlaybookPrinciple[]

  @@index([domain, status])
  @@map("enterprise_playbooks")
}

model EnterprisePlaybookPrinciple {
  playbookId  String
  principleId String
  playbook    EnterprisePlaybook  @relation(fields: [playbookId],  references: [id])
  principle   EnterprisePrinciple @relation(fields: [principleId], references: [id])
  @@id([playbookId, principleId])
  @@map("enterprise_playbook_principles")
}

// Level 7 — Adaptation and governance (derived from lessons or principles)
model PolicyEvolution {
  id             String    @id @default(cuid())
  lessonId       String?
  principleId    String?
  domain         String
  statement      String
  rationale      String
  evidence       String
  confidence     Float
  evidenceCount  Int       @default(1)
  lastValidated  DateTime?
  version        Int       @default(1)
  status         String    @default("ACTIVE") // ACTIVE | SUPERSEDED | DEPRECATED
  supersedes     String?
  supersededBy   String?
  createdAt      DateTime  @default(now())

  lesson         EnterpriseLesson?    @relation(fields: [lessonId],    references: [id])
  principle      EnterprisePrinciple? @relation(fields: [principleId], references: [id])

  @@index([domain, status])
  @@map("policy_evolutions")
}

// ETI Snapshots — written by Trust Engine after every outcome
model ETISnapshot {
  id                       String   @id @default(cuid())
  overallScore             Float
  predictionAccuracy       Float
  decisionAccuracy         Float
  outcomeSuccess           Float
  recommendationAcceptance Float
  calibrationDrift         Float
  coverage                 Float
  stability                Float
  reliability              Float
  snapshotAt               DateTime @default(now())

  @@index([snapshotAt])
  @@map("eti_snapshots")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 6.6 — Digital CEO (Morning Briefing)
// ═══════════════════════════════════════════════════════════════════════════════

model MorningBriefing {
  id             String   @id @default(cuid())
  briefType      String   @default("MORNING") // MORNING | MIDDAY | EVENING
  date           DateTime
  oisScore       Float?
  para1Health    String   // Enterprise Health
