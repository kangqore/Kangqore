// ═══════════════════════════════════════════════════════════════════════════════
// Phase 6.8 — Autonomous Enterprise (Autopilot)
// ═══════════════════════════════════════════════════════════════════════════════

model AutopilotMission {
  id              String   @id @default(cuid())
  intentId        String?  // driving KimmpExecutiveIntent
  objectiveId     String?  // driving KimmpEnterpriseObjective
  title           String
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | ABORTED
  mode            String   @default("SUPERVISED") // SUPERVISED | AUTONOMOUS
  // SUPERVISED = WAANDA proposes, CEO approves. AUTONOMOUS = WAANDA acts.
  actions         Json     // AutopilotAction[]
  lastTickAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([status, mode])
  @@map("autopilot_missions")
}

model AutopilotLog {
  id         String   @id @default(cuid())
  missionId  String?
  action     String   // what WAANDA did or proposed
  rationale  String
  outcome    String?
  approved   Boolean?
  createdAt  DateTime @default(now())

  @@index([missionId, createdAt])
  @@map("autopilot_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 6.9 — Executive Reflection & Enterprise Evolution
// ═══════════════════════════════════════════════════════════════════════════════

model EnterpriseRetrospective {
  id          String   @id @default(cuid())
  scope       String   // MISSION | GOAL | WEEKLY | MONTHLY
  scopeId     String?
  dateFrom    DateTime
  dateTo      DateTime
  planned     Json     // { missions: number, decisions: number, objectives: string[] }
  executed    Json     // { missionsCompleted, decisionsApproved, outcomesRecorded }
  delta       Json     // { oisStart, oisEnd, coigDelta }
  reflection  String   @db.Text
  lessonsRaised     String[]
  patternsConfirmed String[]
  createdAt   DateTime @default(now())

  @@index([scope, dateFrom])
  @@map("enterprise_retrospectives")
}

model ExecutiveReview {
  id            String   @id @default(cuid())
  reviewType    String   // WEEKLY | MONTHLY | QUARTERLY
  weekOf        DateTime
  oisStart      Float?
  oisEnd        Float?
  etiStart      Float?
  etiEnd        Float?
  coigDelta     Float?
  decisionCount Int      @default(0)
  outcomeCount  Int      @default(0)
  lessonCount   Int      @default(0)
  patternCount  Int      @default(0)
  content       String   @db.Text
  createdAt     DateTime @default(now())

  @@index([reviewType, weekOf])
  @@map("executive_reviews")
}

model EnterpriseLetter {
  id        String   @id @default(cuid())
  type      String   // QUARTERLY | ANNUAL | BOARD | INVESTOR
  period    String   // e.g. "Q3-2026" | "2026" | "2026-07"
  content   String   @db.Text
  metrics   Json     // ExecutiveScorecard snapshot at generation time
  createdAt DateTime @default(now())

  @@index([type, period])
  @@map("enterprise_letters")
}

// WAANDA self-governance flag store.
// knowledgeEngine.ts reads COGNITION_PROMOTION_MODE to decide BOOTSTRAP vs GOVERNED.
// evolutionEngine.ts writes it autonomously when readiness thresholds are crossed.
model KimmpFlag {
  id        String   @id @default(cuid())
  key       String   @unique   // e.g. 'COGNITION_PROMOTION_MODE'
  value     String             // e.g. 'GOVERNED' | 'BOOTSTRAP'
  setBy     String   @default("WAANDA")  // 'WAANDA' | 'CEO' | 'SYSTEM'
  reason    String?            // WAANDA's rationale when self-set
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kimmp_flags")
}

model OIISnapshot {
  id         String   @id @default(cuid())
  score      Float
  grade      String
  dimensions Json     // OIIDimension[]
  computedAt DateTime @default(now())

  @@index([computedAt])
  @@map("oii_snapshots")
}

model WaandaDirectiveLog {
  id          String    @id @default(cuid())
  directiveId String    @unique
  to          String                        // SubsystemName
  type        String                        // DirectiveType
  payload     Json
  reason      String?
  accepted    Boolean?
  result      Json?
  issuedAt    DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([to])
  @@index([issuedAt])
  @@map("waanda_directive_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S52 — Agent SDK: External KIMMP Agent Registration
// ═══════════════════════════════════════════════════════════════════════════════

model ExternalAgent {
  id              String    @id @default(cuid())
  name            String
  role            String                        // e.g. SIGNAL_ANALYST, DECISION_SUPPORT, WORKFLOW_EXECUTOR
  capabilities    String[]                      // e.g. ['SWARM_LOG','SIGNAL_ANALYSIS']
  webhookUrl      String
  secret          String                        // HMAC-SHA256 signing secret for outbound payloads
  status          String    @default("ACTIVE")  // ACTIVE | PAUSED | ERROR | REVOKED
  lastPingAt      DateTime?
  lastPingStatus  String?                       // OK | TIMEOUT | ERROR
  lastPingMs      Int?                          // response time in ms
  registeredBy    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@map("external_agents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S53 — WAANDA Gen 2: Fine-tune Job Tracker
// ═══════════════════════════════════════════════════════════════════════════════

model FinetuneJob {
  id           String    @id @default(cuid())
  name         String
  provider     String                         // ANTHROPIC | TOGETHER | HUGGINGFACE | OPENAI
  status       String    @default("PENDING")  // PENDING | EXPORTING | SUBMITTED | TRAINING | COMPLETE | FAILED
  exampleCount Int       @default(0)
  minQuality   Float     @default(0.9)
  format       String    @default("anthropic") // anthropic | openai | jsonl
  exportedAt   DateTime?
  submittedAt  DateTime?
  completedAt  DateTime?
  providerJobId String?                       // provider-assigned ID once submitted
  baseModel    String    @default("claude-haiku-4-5-20251001")
  notes        String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@map("finetune_jobs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S61 — WAANDA Gen 2 Model Registry
// ═══════════════════════════════════════════════════════════════════════════════

model Gen2Model {
  id               String    @id @default(cuid())
  name             String
  provider         String                          // ANTHROPIC | TOGETHER | HUGGINGFACE
  baseModel        String                          // e.g. claude-haiku-4-5-20251001
  providerModelId  String?                         // fine-tuned model ID from provider
  finetuneJobId    String?                         // source FinetuneJob.id
  benchmarkAccuracy Float?                         // 0–1 accuracy vs Gen1 on eval set
  trainingExamples  Int      @default(0)
  isDeployed       Boolean   @default(false)
  deployedAt       DateTime?
  notes            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isDeployed])
  @@map("gen2_models")
}

// S62 — Connector SDK field mappings
model ConnectorFieldMap {
  id             String   @id @default(cuid())
  platform       String                           // salesforce | hubspot | jira | ...
  syncDirection  String   @default("BIDIRECTIONAL") // INBOUND | OUTBOUND | BIDIRECTIONAL
  fieldMaps      Json                             // Array<{sourceField,targetField,transform}>
  webhookEvents  String[]                         // e.g. ["contact.created","deal.updated"]
  isActive       Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, createdBy])
  @@map("connector_field_maps")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S55 — Marketplace MVP
// ═══════════════════════════════════════════════════════════════════════════════

model MarketplaceListing {
  id           String   @id @default(cuid())
  type         String                          // AGENT | INTEGRATION | PACK | WORKFLOW
  name         String
  slug         String   @unique
  author       String
  authorEmail  String?
  category     String                          // productivity | intelligence | crm | finance | hr | ops
  description  String   @db.Text
  longDesc     String?  @db.Text
  oisImpact    String?                         // e.g. "+3–5 OIS points"
  installCount Int      @default(0)
  price        Float    @default(0)            // 0 = free
  platformFee  Float    @default(0.20)         // Kangqore platform fee fraction
  manifest     Json                            // Plugin manifest (name, version, capabilities, schema)
  iconEmoji    String?  @default("🔌")
  tags         String[]
  status       String   @default("PUBLISHED")  // DRAFT | PUBLISHED | SUSPENDED
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status])
  @@index([category, status])
  @@map("marketplace_listings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S66 — Marketplace Monetisation: Tiers, Charges, Reviews
// ═══════════════════════════════════════════════════════════════════════════════

model ListingTier {
  id             String   @id @default(cuid())
  name           String   @unique    // FREE | STARTER | PRO | ENTERPRISE
  monthlyPrice   Float    @default(0)
  quota          Int      @default(0) // API calls/month; 0 = unlimited
  features       String[]
  isActive       Boolean  @default(true)
  stripeProductId String?
  stripePriceId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("listing_tiers")
}

model MarketplaceCharge {
  id                    String   @id @default(cuid())
  listingId             String
  partnerId             String
  amount                Float
  platformFee           Float
  currency              String   @default("USD")
  status                String   @default("PENDING")  // PENDING | CAPTURED | REFUNDED | FAILED
  installId             String?
  stripePaymentIntentId String?
  stripeSessionId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([listingId])
  @@index([partnerId, status])
  @@index([stripeSessionId])
  @@map("marketplace_charges")
}

model MarketplaceReview {
  id           String   @id @default(cuid())
  listingId    String
  authorId     String
  rating       Int                              // 1–5
  comment      String?  @db.Text
  verifiedBadge Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([listingId])
  @@unique([listingId, authorId])
  @@map("marketplace_reviews")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S67 — Multi-Tenant Provisioning
// ═══════════════════════════════════════════════════════════════════════════════

model TenantOrganisation {
  id                   String    @id @default(cuid())
  name                 String
  subdomain            String    @unique
  isolationMode        String    @default("ROW_LEVEL")  // ROW_LEVEL | SCHEMA
  planTier             String    @default("STARTER")     // STARTER | PRO | ENTERPRISE
  maxUsers             Int       @default(10)
  maxAgents            Int       @default(20)
  blueprintId          String?
  blueprintVersion     String?
  enabledModules       String[]                          // e.g. ["AEGIS","KEOS","WAANDA"]
  disabledModules      String[]
  oisSnapshotsPerMonth Int       @default(100)
  apiCallsPerDay       Int       @default(1000)
  isActive             Boolean   @default(true)
  provisionedAt        DateTime?
  provisionedBy        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?   // trial | active | past_due | churned
  currentPeriodEnd     DateTime?
  region               String?   @default("US")  // US | UK | EU | INDIA
  verticalEditionSlug  String?                   // healthtech | legaltech | fintech
  whitelabel           Boolean   @default(false) // true if sub-tenant under OEM partner
  oemPartnerId         String?                   // ref to PartnerOrganisation if whitelabel
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  @@index([isActive])
  @@index([stripeCustomerId])
  @@map("tenant_organisations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S68 — WAANDA Foundation: Autonomy Config + A/B Traffic Split
// ═══════════════════════════════════════════════════════════════════════════════

model AutonomyConfig {
  id              String   @id @default(cuid())
  gen2TrafficPct  Int      @default(0)   // 0–100; % of calls routed to Gen2 first
  enabledAt       DateTime?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("autonomy_config")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S69 — Customer Success Deep: Health Scores + NPS
// ═══════════════════════════════════════════════════════════════════════════════

model CustomerHealthScore {
  id                     String   @id @default(cuid())
  customerId             String                       // links to CustomerPipeline entry
  oisDelta               Float    @default(0)
  coigVelocity           Float    @default(0)
  loginFrequency         Float    @default(0)         // logins/week
  featureDepth           Float    @default(0)         // 0–1 fraction of modules used
  signalVolume           Int      @default(0)         // signals/day avg
  agentUsage             Float    @default(0)         // 0–1 utilisation
  workflowRuns           Int      @default(0)
  blueprintVersionLag    Int      @default(0)         // versions behind current
  npsScore               Float?
  supportTickets         Int      @default(0)
  renewalProximityDays   Int      @default(365)
  daysSinceLastDecision  Int      @default(0)
  totalScore             Float    @default(0)         // computed weighted sum
  tier                   String   @default("GREEN")   // GREEN | AMBER | RED
  // v2 fields (S174)
  oisVelocity            Float?                        // pts/week OIS change
  coigAttribution        Float?                        // % of fleet COIG driven by this customer
  engagementDepthScore   Float?                        // composite engagement 0-100
  healthGrade            String?                       // A | B | C | D
  npsCohort              String?                       // PROMOTER | PASSIVE | DETRACTOR
  computedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  @@index([customerId])
  @@index([tier])
  @@index([healthGrade])
  @@map("customer_health_scores")
}

model NpsResponse {
  id             String   @id @default(cuid())
  customerId     String
  score          Int                              // 0–10
  category       String                           // DETRACTOR (0–6) | PASSIVE (7–8) | PROMOTER (9–10)
  comment        String?  @db.Text
  surveyTrigger  String   @default("MANUAL")      // MANUAL | 30_DAY | 90_DAY | 180_DAY
  createdBy      String?
  createdAt      DateTime @default(now())
  @@index([customerId])
  @@index([category])
  @@map("nps_responses")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S70 — Enterprise Security: SOC2 Controls, RBAC Scopes, Security Findings
// ═══════════════════════════════════════════════════════════════════════════════

model ComplianceControl {
  id           String    @id @default(cuid())
  code         String    @unique              // e.g. "CC1.1", "CC6.3", "ISO-A5.1"
  framework    String    @default("SOC2")     // Overshadow Roadmap P2 — SOC2 | ISO27001. Scopes which
                                               // certification program a checkpoint belongs to; readiness
                                               // tracking only, never a stand-in for an auditor's verdict.
  criteria     String                         // SOC2: CC1–CC9 COSO category. ISO27001: A.5/A.6/A.7/A.8 theme.
  name         String
  description  String    @db.Text
  status       String    @default("MISSING")  // IN_PLACE | PARTIAL | MISSING
  evidenceUrl  String?
  evidenceNote String?   @db.Text
  lastTestedAt DateTime?
  ownerId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([criteria, status])
  @@index([framework, status])
  @@map("compliance_controls")
}

model PermissionScope {
  id         String   @id @default(cuid())
  userId     String
  workspace  String                           // e.g. "AEGIS", "KIMMP", "CRM"
  feature    String                           // e.g. "shield", "signals", "leads"
  action     String                           // READ | WRITE | ADMIN
  grantedBy  String
  createdAt  DateTime @default(now())
  @@unique([userId, workspace, feature])
  @@index([userId])
  @@map("permission_scopes")
}

model OnboardingState {
  id          String    @id @default(cuid())
  userId      String    @unique
  currentStep Int       @default(1)
  completed   Boolean   @default(false)
  oisBaseline Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("onboarding_states")
}

model SecurityFinding {
  id           String    @id @default(cuid())
  title        String
  severity     String                          // CRITICAL | HIGH | MEDIUM | LOW
  status       String    @default("OPEN")      // OPEN | MITIGATED | ACCEPTED
  cveRef       String?
  description  String    @db.Text
  affectedArea String?
  discoveredAt DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([severity, status])
  @@map("security_findings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S71 — Communities: real backend
// ═══════════════════════════════════════════════════════════════════════════════

model CommunityGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  memberCount Int      @default(0)
  isPrivate   Boolean  @default(false)
  topicTags   String[]
  color       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       CommunityPost[]
  members     CommunityMember[]
  @@map("community_groups")
}

model CommunityPost {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  authorId    String
  authorName  String?
  communityId String
  pinned      Boolean  @default(false)
  replyCount  Int      @default(0)
  voteCount   Int      @default(0)
  mediaUrls   String[]
  solved      Boolean  @default(false)
  flagCount   Int      @default(0)
  category    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  community   CommunityGroup   @relation(fields: [communityId], references: [id])
  comments    CommunityComment[]
  votes       CommunityVote[]
  @@index([communityId, createdAt])
  @@index([voteCount])
  @@index([flagCount])
  @@map("community_posts")
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())
  community   CommunityGroup @relation(fields: [communityId], references: [id])
  @@unique([userId, communityId])
  @@index([communityId])
  @@map("community_members")
}

model CommunityComment {
  id         String   @id @default(cuid())
  body       String   @db.Text
  postId     String
  parentId   String?
  authorId   String
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
  @@index([parentId])
  @@map("community_comments")
}

model CommunityVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@map("community_votes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S72 — Analytics + Executive Reporting
// ═══════════════════════════════════════════════════════════════════════════════

model ReportDocument {
  id          String   @id @default(cuid())
  customerId  String
  title       String
  dateFrom    DateTime
  dateTo      DateTime
  data        Json
  status      String   @default("DRAFT")
  generatedBy String?
  createdAt   DateTime @default(now())
  @@index([customerId])
  @@index([status])
  @@map("report_documents")
}

model ScheduledReport {
  id         String    @id @default(cuid())
  title      String
  customerId String?
  cronExpr   String
  recipients String[]
  template   String    @default("EXECUTIVE")
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  active     Boolean   @default(true)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@map("scheduled_reports")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S76 — WAANDA Gen 3 Kernel P1
// ═══════════════════════════════════════════════════════════════════════════════

model PlanDecompositionTree {
  id           String    @id @default(cuid())
  goal         String    @db.Text
  subtasks     Json      @default("[]")
  status       String    @default("PENDING")
  gen2ModelId  String?
  failureCount Int       @default(0)
  replannedAt  DateTime?
  completedAt  DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([status])
  @@index([createdAt])
  @@map("plan_decomposition_trees")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S77 — BIDS™ 16-Pillar Completeness Audit
// ═══════════════════════════════════════════════════════════════════════════════

model BidsPillarAuditRun {
  id           String            @id @default(cuid())
  trigger      String            // 'nightly' | 'manual'
  overallScore Float             @default(0)
  auditedAt    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  scores       BidsPillarScore[]

  @@index([auditedAt])
  @@map("bids_pillar_audit_runs")
}

model BidsPillarScore {
  id                   String   @id @default(cuid())
  runId                String
  pillarId             Int      // 1–16
  pillarName           String
  kpiCount             Int      @default(0)
  workflowTemplateCount Int     @default(0)
  agentsCoverage       Int      @default(0)  // 0–100
  ontologyTypes        Int      @default(0)
  industryPackCoverage Json     @default("[]") // string[] of pack names covering this pillar
  score                Float    @default(0)    // 0–100
  run                  BidsPillarAuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([pillarId])
  @@map("bids_pillar_scores")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S78 — WAANDA Gen 4 Foundation Model (12–24 month horizon)
// ═══════════════════════════════════════════════════════════════════════════════

// Individual curated training example extracted from operational logs
model WaandaFMTrainingExample {
  id         String   @id @default(cuid())
  phase      String   // REASON | DECIDE | PLAN | EXECUTE | LEARN
  prompt     String   @db.Text
  completion String   @db.Text
  sourceType String   // strategic_decision | plan | signal | mission | workflow
  sourceId   String?  // FK to source record (polymorphic)
  quality    Float    @default(0)  // 0–1; filtered by threshold at curation time
  included   Boolean  @default(true)
  scanId     String?
  createdAt  DateTime @default(now())

  @@index([phase])
  @@index([quality])
  @@index([included])
  @@map("waanda_fm_training_examples")
}

// Tracks each corpus curation scan
model WaandaFMCorpusScan {
  id               String   @id @default(cuid())
  trigger          String   @default("manual") // manual | nightly
  qualityThreshold Float    @default(0.85)
  totalScanned     Int      @default(0)
  totalIncluded    Int      @default(0)
  byPhase          Json     @default("{}") // { REASON: n, DECIDE: n, ... }
  scanAt           DateTime @default(now())

  @@index([scanAt])
  @@map("waanda_fm_corpus_scans")
}

// Benchmark evaluation results for candidate base models
model WaandaFMEval {
  id                      String   @id @default(cuid())
  modelCandidate          String   // e.g. "Llama-3-8B" | "Mistral-7B" | "Qwen-14B"
  baseModelSize           String   // e.g. "7B" | "13B" | "70B"
  oisPredictionAccuracy   Float?   // 0–1
  coigRecommendQuality    Float?   // 0–1
  enterpriseReasonScore   Float?   // 0–1
  overallScore            Float?   // 0–1, weighted composite
  evalDataset             String   @default("kangqore-v1")
  notes                   String?  @db.Text
  evalDate                DateTime @default(now())

  @@index([evalDate])
  @@map("waanda_fm_evals")
}

// S82 — Push notification subscriptions (Web Push API)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  auth      String
  p256dh    String
  userId    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S89 — Customer One Blueprint: versioned deployment spec per enterprise tenant
// ═══════════════════════════════════════════════════════════════════════════════

model CustomerBlueprint {
  id           String    @id @default(cuid())
  customerName String
  tenantId     String?                          // TenantOrganisation.id once provisioned
  version      String    @default("1.0")
  planTier     String    @default("PRO")        // STARTER | PRO | ENTERPRISE
  industry     String?
  oisBaseline  Float?                           // OIS score at Day 0 (captured on provision)
  oisTarget    Float?                           // 90-day OIS target
  enabledModules String[]
  spec         Json                             // full blueprint.json spec
  status       String    @default("DRAFT")      // DRAFT | ACTIVE | ARCHIVED
  deployedAt   DateTime?
  deployedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("customer_blueprints")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S117 — Gen2 per-tenant accuracy tracking
// ═══════════════════════════════════════════════════════════════════════════════

model Gen2AccuracyRecord {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String   @default("gen1")  // gen1 | gen2 | waandax
  responseId    String?
  isAccurate    Boolean
  ratingComment String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([provider])
  @@map("gen2_accuracy_records")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S120 — Blueprint Marketplace: publish / fork / rate / version blueprint specs
// ═══════════════════════════════════════════════════════════════════════════════

model MarketplaceBlueprint {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String   @db.Text
  industry      String?
  planTier      String   @default("PRO")       // STARTER | PRO | ENTERPRISE
  version       String   @default("1.0")
  spec          Json                            // blueprint.json payload
  enabledModules String[]
  authorId      String?                         // User.id of publisher
  authorName    String
  forkOf        String?                         // MarketplaceBlueprint.id if forked
  forkCount     Int      @default(0)
  installCount  Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  status        String   @default("PUBLISHED")  // DRAFT | PUBLISHED | DEPRECATED
  tags          String[]
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ratings       MarketplaceBlueprintRating[]

  @@index([status, industry])
  @@index([authorId])
  @@map("marketplace_blueprints")
}

model MarketplaceBlueprintRating {
  id          String   @id @default(cuid())
  blueprintId String
  userId      String
  rating      Int                              // 1–5
  review      String?  @db.Text
  createdAt   DateTime @default(now())
  blueprint   MarketplaceBlueprint @relation(fields: [blueprintId], references: [id])

  @@unique([blueprintId, userId])
  @@index([blueprintId])
  @@map("marketplace_blueprint_ratings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// S121 — Partner Portal: implementation partner org + commission ledger
// ═══════════════════════════════════════════════════════════════════════════════

model PartnerOrganisation {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  contactEmail    String
  website         String?
  tier            String   @default("SILVER")  // BRONZE | SILVER | GOLD | PLATINUM
  commissionRate  Float    @default(0.15)       // 15% default
  stripeAccountId String?                       // Stripe Connect account
  status          String   @default("ACTIVE")   // PENDING | ACTIVE | SUSPENDED
