generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                         String                     @id @default(cuid())
  email                      String                     @unique
  password                   String?
  name                       String
  company                    String?
  role                       Role                       @default(CLIENT)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  phone                      String?
  resetToken                 String?
  resetTokenExpiry           DateTime?
  avatarUrl                  String?
  companyEmail               String?
  employeeEmail              String?
  github                     String?
  gmail                      String?
  lastLoginAt                DateTime?
  linkedin                   String?
  status                     UserStatus                 @default(ACTIVE)
  twitter                    String?
  collegeEmail               String?
  customId                   String?                    @unique
  location                   String?
  purpose                    String?
  appleId                    String?                    @unique
  googleId                   String?                    @unique
  linkedinId                 String?                    @unique
  isRedFlagged               Boolean                    @default(false)
  twoFactorEnabled           Boolean                    @default(false)
  twoFactorSecret            String?
  twoFactorRecoveryCodes     String[]                   @default([])
  age                        Int?
  gender                     String?
  profession                 String?
  documents                  String[]                   @default([])
  portfolio                  Json?
  investorInterests          String[]
  investorPortfolio          String[]
  authorityRole              String?
  clientProfile              ClientProfile?             @relation("ClientProfileOwner")
  clientAccountabilityEvents AccountabilityEvent[]      @relation("ClientAccountability")
  userAccountabilityEvents   AccountabilityEvent[]      @relation("UserAccountability")
  clientObligations          AccountabilityObligation[] @relation("ClientObligations")
  userObligations            AccountabilityObligation[] @relation("UserObligations")
  clientSnapshots            AccountabilitySnapshot[]   @relation("ClientSnapshots")
  adminItems                 AdminItem[]
  clientAssumptions          Assumption[]
  auditLogs                  AuditLog[]
  changeRequests             ChangeRequest[]            @relation("ChangeRequestClient")
  clientFeedbacks            ClientFeedback[]
  contents                   Content[]
  conversations              Conversation[]
  decisionStatusHistory      DecisionStatusHistory[]
  decisionViews              DecisionView[]
  approvedDecisions          Decision[]                 @relation("DecisionApprover")
  decisions                  Decision[]
  deliverables               Deliverable[]
  partnerDeliverables        Deliverable[]              @relation("PartnerDeliverables")
  clientDependencies         Dependency[]
  receivedDocuments          Document[]                 @relation("ClientDocuments")
  emails                     EmailLog[]                 @relation("ClientEmails")
  investorEmails             EmailLog[]                 @relation("InvestorEmails")
  jobSeekerEmails            EmailLog[]                 @relation("JobSeekerEmails")
  partnerEmails              EmailLog[]                 @relation("PartnerEmails")
  insights                   Insight[]
  invoices                   Invoice[]
  clientIssues               Issue[]
  meetings                   Meeting[]                  @relation("ClientMeetings")
  createdMeetings            Meeting[]                  @relation("CreatedMeetings")
  investorMeetings           Meeting[]                  @relation("InvestorMeetings")
  jobSeekerMeetings          Meeting[]                  @relation("JobSeekerMeetings")
  partnerMeetings            Meeting[]                  @relation("PartnerMeetings")
  partnerMessages            Message[]                  @relation("PartnerMessages")
  receivedMessages           Message[]                  @relation("ReceivedMessages")
  sentMessages               Message[]                  @relation("SentMessages")
  notifications              Notification[]
  oauthProviders             OAuthProvider[]
  productVersions            ProductVersion[]
  projects                   Project[]
  ledProjects                Project[]                  @relation("ProjectLead")
  partnerProjects            Project[]                  @relation("PartnerProjects")
  readingHistory             ReadingHistory[]
  resourceLinks              ResourceLink[]
  risks                      Risk[]
  ledServiceLines            ServiceLine[]
  sessions                   Session[]
  tasks                      Task[]
  partnerTasks               Task[]                     @relation("PartnerTasks")
  ticketMessages             TicketMessage[]
  tickets                    Ticket[]

  availabilitySchedules AvailabilitySchedule[] @relation("UserAvailability")
  hostedEventTypes      EventType[]            @relation("HostedEventTypes")
  meetingLocations      MeetingLocation[]      @relation("UserLocations")
  orgMemberships        OrgMembership[]        @relation("UserMemberships")
  ownedRoutingForms     RoutingForm[]          @relation("OwnedRoutingForms")
  hostedEvents          ScheduledEvent[]       @relation("EventHost")
  ownedSchedulingLinks  SchedulingLink[]       @relation("OwnedSchedulingLinks")
  calendarIntegrations  CalendarIntegration[]
  zoomIntegration       ZoomIntegration?
  crmIntegrations       CRMIntegration[]
  customDomains         CustomDomain[]
  EventTypeTeamMember   EventTypeTeamMember[]
  crMessages            ChangeRequestMessage[] @relation("CRMessageSender")

  // RELAY
  deptId                String?
  channelsCreated       Channel[]              @relation("ChannelCreatedBy")
  channelMemberships    ChannelMember[]
  chatMessages          ChatMessage[]          @relation("ChatMessageAuthor")
  messageReactions      MessageReaction[]
  userPresence          UserPresence?
  programmaticApiKeys   ProgrammaticApiKey[]
  incidentsAssigned     Incident[]            @relation("IncidentAssignee")
  incidentsReported     Incident[]            @relation("IncidentReporter")
  problemsAssigned      Problem[]             @relation("ProblemAssignee")

  // BIDS™
  bidsActive             Boolean            @default(false)
  bidsEngagement         BidsEngagement?    @relation("BidsClient")
  clientMilestones       ClientMilestone[]  @relation("ClientMilestoneOwner")
  projectMilestones      ProjectMilestone[] @relation("ProjectMilestoneOwner")

  // URGI™ Platform
  unifiedProfile  UnifiedRelationshipProfile?

  @@map("users")
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String
  type        String   @default("ASSET")
  size        Int?
  clientId    String
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String?
  client      User     @relation("ClientDocuments", fields: [clientId], references: [id])
  project     Project? @relation("ProjectDocuments", fields: [projectId], references: [id])

  @@map("documents")
}

model Project {
  id                        String                     @id @default(cuid())
  title                     String
  description               String?
  status                    ProjectStatus              @default(ACTIVE)
  clientId                  String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  partnerId                 String?
  constraints               Json?
  priorityOrder             String?
  budget                    Decimal?                   @db.Decimal(12, 2)
  dueDate                   DateTime?
  services                  String[]
  progress                  Int?                       @default(0)
  progressCalculationMethod String?                    @default("MANUAL")
  progressConfidence        Float?                     @default(0)
  progressEvidence          Json?
  progressLastValidated     DateTime?
  progressOverride          Boolean                    @default(false)
  progressOverrideReason    String?
  category                  String?                    @default("Transformation")
  health                    Int                        @default(100)
  nextGate                  String?
  spend                     Decimal?                   @default(0) @db.Decimal(12, 2)
  leadId                    String?
  adminConfidenceScore      Int?                       @default(0)
  clientSentimentScore      Int?                       @default(0)
  lastAlignmentCheck        DateTime?
  slaMetrics                Json?
  vision                    String?
  visionClientFeedback      String?
  visionStatus              String                     @default("PENDING")
  visionWorkflows           Json?
  objectives                BusinessObjective[]
  accountabilityEvents      AccountabilityEvent[]
  projectObligations        AccountabilityObligation[] @relation("ProjectObligations")
  projectSnapshots          AccountabilitySnapshot[]   @relation("ProjectSnapshots")
  assumptions               Assumption[]
  changeRequests            ChangeRequest[]
  clientFeedbacks           ClientFeedback[]           @relation("ProjectFeedbacks")
  decisions                 Decision[]
  deliverables              Deliverable[]
  dependencies              Dependency[]
  documents                 Document[]                 @relation("ProjectDocuments")
  invoices                  Invoice[]
  issues                    Issue[]
  productVersions           ProductVersion[]           @relation("ProjectVersions")
  client                    User                       @relation(fields: [clientId], references: [id])
  lead                      User?                      @relation("ProjectLead", fields: [leadId], references: [id])
  partner                   User?                      @relation("PartnerProjects", fields: [partnerId], references: [id])
  risks                     Risk[]
  tasks                     Task[]
  serviceLines              ServiceLine[]              @relation("ProjectToServiceLine")
  operationalState          ProjectOperationalState?
  digitalTwin               ProjectDigitalTwin?
  milestones                ProjectMilestone[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Deliverable {
  id                    String                @id @default(cuid())
  title                 String
  description           String?
  status                String                @default("pending")
  projectId             String
  clientId              String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  partnerId             String?
  acceptanceCriteria    String?
  complianceCheckPassed Boolean               @default(false)
  qualityGateStatus     String                @default("PENDING")
  securityScanPassed    Boolean               @default(false)
  approvedAt            DateTime?
  approvedByRole        String?
  invoiceId             String?
  dueDate               DateTime?
  accountabilityEvents  AccountabilityEvent[]
  client                User                  @relation(fields: [clientId], references: [id])
  invoice               Invoice?              @relation(fields: [invoiceId], references: [id])
  partner               User?                 @relation("PartnerDeliverables", fields: [partnerId], references: [id])
  project               Project               @relation(fields: [projectId], references: [id])
  deliverySignals       DeliverySignal[]
  externalResources     ExternalResource[]

  @@map("deliverables")
}

model ExternalResource {
  id            String      @id @default(cuid())
  deliverableId String
  resourceType  String
  externalId    String
  lastSyncAt    DateTime?
  createdAt     DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@map("external_resources")
}

model DeliverySignal {
  id            String      @id @default(cuid())
  deliverableId String
  signalType    String
  source        String
  payload       Json?
  timestamp     DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@map("delivery_signals")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo")
  projectId   String
  clientId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  partnerId   String?
  dueDate     DateTime?
  client      User      @relation(fields: [clientId], references: [id])
  partner     User?     @relation("PartnerTasks", fields: [partnerId], references: [id])
  project     Project   @relation(fields: [projectId], references: [id])

  @@map("tasks")
}

model Insight {
  id            String   @id @default(cuid())
  title         String
  category      String
  content       String
  tags          String   @default("")
  authorId      String
  authorName    String
  authorCompany String
  views         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  author        User     @relation(fields: [authorId], references: [id])

  @@map("insights")
}

model MediaFile {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedBy   String
  createdAt    DateTime @default(now())
  altText      String?
  folder       String?
  title        String?

  @@map("media_files")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  lastActive   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OAuthProvider {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  email          String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_providers")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  kind      String?  @default("chatbot")
  meta      Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind, createdAt])
  @@map("conversations")
}

model KnowledgeChunk {
  id          String   @id
  sourceFile  String
  parentId    String
  title       String
  body        String
  tags        String[]
  embedding   Float[]
  // S316 — real pgvector column alongside the original Float[]. Additive:
  // Float[] is untouched, this is populated by a separate backfill script.
  // Prisma can't read/write Unsupported columns via the normal client API —
  // all access goes through $queryRaw/$executeRaw (see embeddingVector.service.ts).
  embeddingVector Unsupported("vector(1024)")?
  embedModel  String?
  contentHash String
  populated   Boolean  @default(true)
  internal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([sourceFile])
  @@index([contentHash])
  @@map("knowledge_chunks")
}

model ConciergeFeedback {
  id             String   @id @default(cuid())
  conversationId String
  messageIndex   Int
  rating         String
  reason         String?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([rating, createdAt])
  @@map("concierge_feedback")
}

model Risk {
  id                   String                @id @default(cuid())
  title                String
  description          String?
  severity             String
  status               String                @default("OPEN")
  probability          String?
  impact               String?
  owner                String?
  projectId            String
  clientId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  acceptanceNote       String?
  clientAcceptedAt     DateTime?
  clientAcceptedBy     String?
  acceptanceSignature  String?
  isClientVisible      Boolean               @default(true)
  sourceEmailId        String?
  sourceMeetingId      String?
  sourceMessageId      String?
  clientResponse       String?
  clientResponseAt     DateTime?
  contingencyPlan      String?
  mitigationPlan       String?
  riskOwner            String?               @default("SHARED")
  trend                String?               @default("STABLE")
  accountabilityEvents AccountabilityEvent[]
  mitigatingDecisions  Decision[]
  client               User                  @relation(fields: [clientId], references: [id])
  project              Project               @relation(fields: [projectId], references: [id])
  sourceEmail          EmailLog?             @relation("RiskFromEmail", fields: [sourceEmailId], references: [id])
  sourceMeeting        Meeting?              @relation("RiskFromMeeting", fields: [sourceMeetingId], references: [id])
  sourceMessage        Message?              @relation("RiskFromMessage", fields: [sourceMessageId], references: [id])

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@map("risks")
}

model Decision {
  id                   String                  @id @default(cuid())
  title                String
  description          String
  status               String                  @default("DRAFT")
  priority             String?
  dueDate              DateTime?
  projectId            String
  clientId             String
  approverId           String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  approvalRole         String?
  approvedAt           DateTime?
  changeRequestId      String?
  riskId               String?
  impactCost           String?
  impactRisk           String?
  impactTime           String?
  sourceEmailId        String?
  sourceMeetingId      String?
  sourceMessageId      String?
  category             String?
  accountabilityEvents AccountabilityEvent[]
  statusHistory        DecisionStatusHistory[]
  views                DecisionView[]
  approver             User?                   @relation("DecisionApprover", fields: [approverId], references: [id])
  changeRequest        ChangeRequest?          @relation("ChangeApproval", fields: [changeRequestId], references: [id])
  client               User                    @relation(fields: [clientId], references: [id])
  project              Project                 @relation(fields: [projectId], references: [id])
  risk                 Risk?                   @relation(fields: [riskId], references: [id])
  sourceEmail          EmailLog?               @relation("DecisionFromEmail", fields: [sourceEmailId], references: [id])
  sourceMeeting        Meeting?                @relation("DecisionFromMeeting", fields: [sourceMeetingId], references: [id])
  sourceMessage        Message?                @relation("DecisionFromMessage", fields: [sourceMessageId], references: [id])

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@map("decisions")
}

model DecisionView {
  id         String   @id @default(cuid())
  decisionId String
  userId     String
  duration   Int      @default(0)
  createdAt  DateTime @default(now())
  decision   Decision @relation(fields: [decisionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([decisionId])
  @@index([userId])
  @@map("decision_views")
}

model DecisionStatusHistory {
  id         String   @id @default(cuid())
  decisionId String
  fromStatus String
  toStatus   String
  userId     String
  createdAt  DateTime @default(now())
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([decisionId])
  @@index([userId])
  @@map("decision_status_history")
}

model Expense {
  id           String    @id @default(cuid())
  title        String
  category     String    @default("Other")
  amount       Decimal   @db.Decimal(10, 2)
  currency     String    @default("INR")
  expenseDate  DateTime  @default(now())
  status       String    @default("PENDING")
  notes        String?
  projectId    String?
  submittedBy  String
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([expenseDate])
  @@index([submittedBy])
  @@map("expenses")
}

model Invoice {
  id                 String          @id @default(cuid())
  invoiceNumber      String          @unique
  amount             Decimal         @db.Decimal(10, 2)
  currency           String          @default("USD")
  status             String          @default("DRAFT")
  issueDate          DateTime        @default(now())
  dueDate            DateTime
  paidAt             DateTime?
  fileUrl            String?
  notes              String?
  projectId          String?
  clientId           String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  changeRequests     ChangeRequest[]
  linkedDeliverables Deliverable[]
  client             User            @relation(fields: [clientId], references: [id])
  project            Project?        @relation(fields: [projectId], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

model ChangeRequest {
  id                     String                @id @default(cuid())
  title                  String
  description            String
  status                 String                @default("PROPOSED")
  priority               String                @default("MEDIUM")
  costImpact             Decimal?              @db.Decimal(10, 2)
  timeImpact             String?
  projectId              String
  clientId               String
  requestedBy            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  invoiceId              String?
  rejectionImpact        String?
  sourceEmailId          String?
  sourceMeetingId        String?
  sourceMessageId        String?
  acknowledgedAt         DateTime?
  acknowledgedBy         String?
  adminResponseRationale String?
  decisionType           String
  rationale              String?
  tradeoffs              String?
  accountabilityEvents   AccountabilityEvent[]
  client                 User                  @relation("ChangeRequestClient", fields: [clientId], references: [id])
  invoice                Invoice?              @relation(fields: [invoiceId], references: [id])
  project                Project               @relation(fields: [projectId], references: [id])
  sourceEmail            EmailLog?             @relation("ChangeFromEmail", fields: [sourceEmailId], references: [id])
  sourceMeeting          Meeting?              @relation("ChangeFromMeeting", fields: [sourceMeetingId], references: [id])
  sourceMessage          Message?              @relation("ChangeFromMessage", fields: [sourceMessageId], references: [id])
  approvingDecisions     Decision[]            @relation("ChangeApproval")
  messages               ChangeRequestMessage[]

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@map("change_requests")
}

model ChangeRequestMessage {
  id              String        @id @default(cuid())
  changeRequestId String
  senderId        String
  content         String        @db.Text
  createdAt       DateTime      @default(now())
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  sender          User          @relation("CRMessageSender", fields: [senderId], references: [id])

  @@index([changeRequestId])
  @@map("change_request_messages")
}

model Content {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  contentType    String
  status         String             @default("DRAFT")
  content        String
  excerpt        String?
  featuredImage  String?
  metaTitle      String?
  metaDesc       String?
  keywords       String?
  authorId       String
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       String?
  tags           String?
  metadata       Json?
  analytics      ContentAnalytics[]
  shares         ContentShare[]
  views          ContentView[]
  author         User               @relation(fields: [authorId], references: [id])
  readingHistory ReadingHistory[]

  @@map("contents")
}

model Consultation {
  id                  String             @id @default(cuid())
  name                String
  email               String
  phone               String?
  company             String?
  service             String?
  preferredDate       String?
  message             String?
  source              String?
  status              ConsultationStatus @default(PENDING)
  notes               String?
  assignedTo          String?
  contactedAt         DateTime?
  scheduledAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  location            String?
  meetingLink         String?
  meetingMode         String?
  previousScheduledAt DateTime?
  topic               String?
  services            String[]

  @@index([status, createdAt])
  @@index([email])
  @@map("consultations")
}

model Contact {
  id                 String        @id @default(cuid())
  name               String
  email              String
  phone              String?
  subject            String?
  message            String
  source             String?
  status             ContactStatus @default(NEW)
  notes              String?
  repliedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  inquiryType        String?
  organization       String?
  region             String?
  interestedServices String[]

  @@index([status, createdAt])
  @@index([email])
  @@map("contacts")
}

model Job {
  id           String           @id @default(cuid())
  title        String
  description  String
  department   String?
  location     String?
  type         String
  status       String           @default("OPEN")
  salaryRange  String?
  requirements String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@map("jobs")
}

model JobApplication {
  id             String            @id @default(cuid())
  name           String
  email          String
  phone          String?
  position       String
  resumeUrl      String?
  coverLetter    String?
  linkedin       String?
  portfolio      String?
  experience     String?
  location       String?
  expectedSalary String?
  source         String?
  status         ApplicationStatus @default(RECEIVED)
  notes          String?
  interviewedAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  jobId          String?
  job            Job?              @relation(fields: [jobId], references: [id])

  @@index([status, createdAt])
  @@index([email])
  @@index([position])
  @@map("job_applications")
}

model Visit {
  id        String   @id @default(cuid())
  ip        String
  country   String?
  region    String?
  city      String?
  isp       String?
  browser   String?
  os        String?
  device    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([country])
  @@map("visits")
}

model AdminItem {
  id          String        @id @default(cuid())
  type        AdminItemType
  entityType  String
  entityId    String
  notes       String?
  scheduledAt DateTime?
  adminId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  admin       User          @relation(fields: [adminId], references: [id])

  @@unique([type, entityType, entityId, adminId])
  @@index([type])
  @@index([adminId])
  @@map("admin_items")
}

model ContentView {
  id        String   @id @default(cuid())
  contentId String
  userId    String?
  viewerIp  String?
  userAgent String?
  device    String?
  browser   String?
  country   String?
  city      String?
  region    String?
  referrer  String?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([userId])
  @@index([createdAt])
  @@index([country])
  @@map("content_views")
}

model ContentShare {
  id        String   @id @default(cuid())
  contentId String
  userId    String?
  platform  String
  createdAt DateTime @default(now())
