// ============================================================================
// KANGQORE URGI™ (USER RELATIONSHIP GROWTH INTELLIGENCE) - INTERNAL PLATFORM
// ============================================================================

model UnifiedRelationshipProfile {
  id                  String   @id @default(uuid())
  userId              String?  @unique // Optional link to authenticated User
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitorId           String?  @unique // For anonymous tracking
  
  // Identity & Memory (Mutable)
  currentCompany      String?
  currentRole         String?
  industry            String?
  preferredChannel    String?
  communicationStyle  String?
  
  // Scoring
  relationshipScore   Float    @default(0.0)
  trustScore          Float    @default(0.0)
  engagementScore     Float    @default(0.0)

  // Relationships
  evidence            EvidenceLedger[]
  timeline            RelationshipTimelineEvent[]
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([visitorId])
  @@map("urgi_unified_relationship_profiles")
}

model EvidenceLedger {
  id                  String   @id @default(uuid())
  profileId           String
  profile             UnifiedRelationshipProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  factKey             String   // e.g. "company", "role", "intent"
  factValue           String   // e.g. "TCS", "Enterprise Architect"
  
  source              String   // e.g. "LinkedIn", "User", "AI_Inference"
  confidenceScore     Float    // e.g. 0.93 for 93%
  
  evidenceType        String   // OBSERVATION, INFERENCE, HYPOTHESIS, VERIFIED
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([profileId])
  @@index([factKey])
  @@map("urgi_evidence_ledgers")
}

model RelationshipTimelineEvent {
  id                  String   @id @default(uuid())
  profileId           String
  profile             UnifiedRelationshipProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  eventType           String   // e.g. "PAGE_VISIT", "QUESTION_ASKED", "IDENTITY_VERIFIED"
  description         String
  metadata            Json?    // Optional payload
  
  createdAt           DateTime @default(now()) // Immutable timestamp

  @@index([profileId])
  @@index([eventType])
  @@map("urgi_relationship_timeline_events")
}

// ============================================================================
// KEOS (Kangqore Enterprise Operating System) - KORE ONTOLOGY KERNEL
// ============================================================================

model KoreObject {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Invoice", "Meeting"
  description String?
  isSystem    Boolean  @default(false)
  properties        KoreProperty[]
  actions           KoreAction[]
  relationships     KoreRelationship[] @relation("SourceRelationships")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("kore_objects")
}

model KoreProperty {
  id          String     @id @default(uuid())
  objectId    String
  object      KoreObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  
  name        String     // e.g., "amount"
  type        String     // e.g., "STRING", "NUMBER", "DATE", "BOOLEAN"
  isRequired  Boolean    @default(false)
  isUnique    Boolean    @default(false)
  description String?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([objectId, name])
  @@map("kore_properties")
}

model KoreAction {
  id          String     @id @default(uuid())
  objectId    String
  object      KoreObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  
  name        String     // e.g., "approve", "cancel"
  description String?
  permissions String[]   // Roles or capabilities required
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([objectId, name])
  @@map("kore_actions")
}

model KoreRelationship {
  id               String     @id @default(uuid())
  sourceObjectId   String
  sourceObject     KoreObject @relation("SourceRelationships", fields: [sourceObjectId], references: [id], onDelete: Cascade)

  relationName     String     // e.g. "hasMany", "belongsTo", "references"
  targetObjectName String     // e.g. "Invoice", "Project"
  cardinality      String     @default("ONE_TO_MANY") // ONE_TO_ONE | ONE_TO_MANY | MANY_TO_MANY
  isRequired       Boolean    @default(false)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([sourceObjectId, relationName, targetObjectName])
  @@map("kore_relationships")
}

