  name        String // e.g. "AI & Autonomous Systems"
  slug        String   @unique // e.g. "ai-autonomous"
  description String?
  leadId      String? // Link to User (Partner)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metrics  PracticeMetric[]
  projects Project[] // Relation to projects tagged with this service
  lead     User?            @relation(fields: [leadId], references: [id])

  @@map("service_lines")
}

model PracticeMetric {
  id            String   @id @default(cuid())
  serviceLineId String
  period        DateTime // First day of the month
  revenue       Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  margin        Decimal  @db.Decimal(5, 2) // Percentage
  utilization   Decimal  @db.Decimal(5, 2) // Percentage
  headcount     Int
  bench         Int
  createdAt     DateTime @default(now())

