  @@unique([eventId, email])
  @@index([eventId])
  @@index([email])
  @@map("event_invitees")
}

model EventType {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  name                  String
  description           String?
  duration              Int
  color                 String                 @default("#2564ea")
  bufferBefore          Int                    @default(0)
  bufferAfter           Int                    @default(0)
  maxPerDay             Int?
  minNotice             Int                    @default(60)
  maxAdvanceDays        Int                    @default(30)
  hostId                String
  isActive              Boolean                @default(true)
  isPublic              Boolean                @default(true)
  location              String?
  locationType          String                 @default("VIDEO")
  videoProvider         String                 @default("JITSI")
  requirePhone          Boolean                @default(false)
  requireCompany        Boolean                @default(false)
  customQuestions       Json?
  durationOptions       Json?
  assignmentStrategy    AssignmentStrategy     @default(SINGLE_HOST)
  lastAssignedMemberId  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  host                  User                   @relation("HostedEventTypes", fields: [hostId], references: [id])
  teamMembers           EventTypeTeamMember[]
  scheduledEvents       ScheduledEvent[]
  schedulingLinks       SchedulingLink[]
  availabilitySchedules AvailabilitySchedule[] @relation("AvailabilityScheduleToEventType")
  emailTemplates        EmailTemplate[]
  webhooks              Webhook[]
  workflows             Workflow[]

  @@index([hostId])
  @@index([slug])
  @@index([isActive, isPublic])
  @@map("event_types")
}

model EventTypeTeamMember {
  id          String @id @default(cuid())
  eventTypeId String
  userId      String
  weight      Int    @default(1)

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventTypeId, userId])
  @@map("event_type_team_members")
}

model EmailTemplate {
  id          String     @id @default(cuid())
  eventTypeId String?
  type        String // CONFIRMATION, REMINDER_24H, REMINDER_1H, CANCELLATION, FOLLOW_UP
  subject     String
  bodyHtml    String     @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@unique([eventTypeId, type])
  @@index([eventTypeId])
  @@map("email_templates")
}

model Webhook {
  id          String   @id @default(cuid())
  userId      String?  // owner (null = legacy event-type-scoped)
  eventTypeId String?
  url         String
  secret      String?
  events      Json?    // string[] — e.g. ["booking.created"]. null = all events
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventType  EventType?        @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([eventTypeId])
  @@index([userId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  payload      Json
  status       String // e.g. "SUCCESS", "FAILED"
  statusCode   Int?
  responseBody String?  @db.Text
  requestTime  DateTime @default(now())
  responseTime Int? // in ms

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model Workflow {
  id            String   @id @default(cuid())
  eventTypeId   String?
  trigger       String // e.g. "BEFORE_EVENT", "AFTER_EVENT", "ON_BOOKED"
  offsetMinutes Int? // e.g. -1440 for 24 hours before
  action        String // e.g. "SEND_EMAIL", "CALL_WEBHOOK"
  actionConfig  Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  eventType EventType?    @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  jobs      WorkflowJob[]

  @@index([eventTypeId])
  @@map("workflows")
}

model WorkflowJob {
  id           String    @id @default(cuid())
  workflowId   String
  eventId      String
  scheduledFor DateTime?
  status       String    @default("PENDING") // PENDING, COMPLETED, FAILED
  resultLog    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  event    ScheduledEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([eventId])
  @@index([status, scheduledFor])
  @@map("workflow_jobs")
}

model InviteeNoShow {
