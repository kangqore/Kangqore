}

// ── Client CRM sub-entities ───────────────────────────────────────────────────

model ClientInteraction {
  id        String    @id @default(cuid())
  clientId  String
  type      String    // call|email|meeting|note|milestone
  title     String
  summary   String    @db.Text
  date      DateTime
  owner     String
  client    ClientCRM @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_interactions")
}

model ClientSLA {
  id        String    @id @default(cuid())
  clientId  String
  metric    String
  target    Float
  current   Float
  unit      String
  period    String
  status    String    // met|at-risk|breached
  trend     String    @default("stable") // up|down|stable
  client    ClientCRM @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_slas")
}

model ClientMilestone {
  id             String    @id @default(cuid())
  clientId       String
  projectId      String    @default("")
  title          String
  description    String    @db.Text
  dueDate        DateTime
  completedDate  DateTime?
  status         String    // completed|in-progress|upcoming|delayed
  owner          String    // display name (kept for backwards compat)
  ownerId        String?   // FK to User
  user           User?     @relation("ClientMilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  client         ClientCRM @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([ownerId])
  @@map("client_milestones")
}

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  description   String    @db.Text
  dueDate       DateTime
  completedDate DateTime?
  status        String    @default("upcoming")  // completed|in-progress|upcoming|delayed
  ownerId       String?
  createdAt     DateTime  @default(now())
  owner         User?     @relation("ProjectMilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([ownerId])
  @@map("project_milestones")
}

model ClientGovernanceItem {
  id          String    @id @default(cuid())
  clientId    String
  type        String    // decision|change-request|steering|escalation
  title       String
  description String    @db.Text
  status      String    // open|approved|rejected|pending|closed
  owner       String
  date        DateTime
  priority    String    // critical|high|medium|low
  resolution  String?   @db.Text
  client      ClientCRM @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_governance")
}

// ── Partner CRM sub-entities ──────────────────────────────────────────────────

model CrmPartnerTask {
  id            String     @id @default(cuid())
  partnerId     String
  partnerName   String
  projectId     String     @default("")
  projectName   String     @default("")
  title         String
  description   String     @db.Text
  status        String     // assigned|in-progress|review|completed|overdue
  priority      String     // critical|high|medium|low
  assignedDate  DateTime
  dueDate       DateTime
  completedDate DateTime?
  storyPoints   Int        @default(0)
  fee           Float      @default(0)
  partner       PartnerCRM @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("crm_partner_tasks")
}

model CrmPartnerDeliverable {
  id             String     @id @default(cuid())
  partnerId      String
  partnerName    String
  projectId      String     @default("")
  projectName    String     @default("")
  title          String
  description    String     @db.Text
  status         String     // not-started|in-progress|submitted|approved|revision
  dueDate        DateTime
  submittedDate  DateTime?
  approvedDate   DateTime?
  fee            Float      @default(0)
  feedback       String?    @db.Text
  partner        PartnerCRM @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("crm_partner_deliverables")
}

model CrmPartnerPayment {
  id            String     @id @default(cuid())
  partnerId     String
  partnerName   String
  invoiceNumber String
  description   String
  amount        Float      @default(0)
  status        String     // pending|paid|overdue|processing
  issuedDate    DateTime
  dueDate       DateTime
  paidDate      DateTime?
  partner       PartnerCRM @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("crm_partner_payments")
}

model CrmPartnerNote {
  id        String     @id @default(cuid())
  partnerId String
  content   String     @db.Text
  author    String
  date      DateTime
  type      String     @default("general") // general|performance|issue|praise
  partner   PartnerCRM @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("crm_partner_notes")
}

// ── Partner CRM ───────────────────────────────────────────────────────────────
// Company-level CRM records for delivery/tech partners. Separate from User accounts.

model PartnerCRM {
  id                 String   @id @default(cuid())
  name               String
  type               String   @default("agency")        // subcontractor|agency|freelancer|consultancy
  tier               String   @default("associate")     // platinum|gold|silver|associate
  status             String   @default("active")        // active|onboarding|paused|offboarded
  country            String?
  specialisms        String[]
  rating             Float    @default(0)               // 0–5
  contactName        String?
  contactRole        String?
  contactEmail       String?
  contactPhone       String?
  joinDate           DateTime?
  totalEarned        Float    @default(0)
  pendingPayment     Float    @default(0)
  activeTasks        Int      @default(0)
  completedProjects  Int      @default(0)
  description        String?  @db.Text
  logo               String?
  hourlyRate         Float    @default(0)
  projectIds         String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tasks              CrmPartnerTask[]
  deliverables       CrmPartnerDeliverable[]
  payments           CrmPartnerPayment[]
  notes              CrmPartnerNote[]

  @@map("partner_crm")
}

// ── Client CRM ────────────────────────────────────────────────────────────────
// Company-level CRM records. Separate from User/ClientProfile (which tracks
// individual login accounts and compliance data).

model ClientCRM {
  id                String          @id @default(cuid())
  name              String          // company name
  industry          String?
  country           String?
  tier              String          @default("standard")   // strategic|enterprise|standard|starter
  status            String          @default("active")     // active|onboarding|paused|churned
  health            String          @default("good")       // excellent|good|at-risk|critical
  arr               Float           @default(0)            // Annual Recurring Revenue £
  contractStart     DateTime?
  contractEnd       DateTime?
  accountManager    String?
  satisfactionScore Int             @default(0)            // 0–100
  description       String?         @db.Text
  logo              String?         // 2-letter initials
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  contacts          ClientContact[]
  interactions      ClientInteraction[]
  slas              ClientSLA[]
  milestones        ClientMilestone[]
  governance        ClientGovernanceItem[]
  projectIds        String[]        @default([])

  @@map("client_crm")
}

model ClientContact {
  id        String    @id @default(cuid())
  clientId  String
  name      String
  role      String
  email     String
  phone     String?
  isPrimary Boolean   @default(false)
  client    ClientCRM @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ── OS Automation Workflows ────────────────────────────────────────────────────
// Separate from the calendar Workflow model (which handles scheduling triggers).
// These are business-process automation workflows displayed in /os/workflows.

model OsWorkflow {
  id            String          @id @default(cuid())
  name          String
  description   String          @db.Text
  category      String          // sales | delivery | hr | finance | ops | marketing
  status        String          @default("draft") // active | paused | draft | archived
  triggerType   String          // manual | schedule | event | webhook | form
  triggerConfig String
  steps         Json            // WorkflowStep[]
  lastRun       DateTime?
  nextRun       DateTime?
  runsTotal     Int             @default(0)
  runsSuccess   Int             @default(0)
  runsFailed    Int             @default(0)
  avgDuration   Float           @default(0) // minutes
  owner         String
  tags          String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  runs          OsWorkflowRun[]

  @@map("os_workflows")
}

model OsWorkflowRun {
  id             String      @id @default(cuid())
  workflowId     String
  workflowName   String
  status         String      // running | completed | failed | skipped
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  duration       Int?        // seconds
  triggeredBy    String
  stepsCompleted Int         @default(0)
  stepsTotal     Int         @default(0)
  errorMessage   String?
  workflow       OsWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status, startedAt])
  @@map("os_workflow_runs")
}

model InvestorUpdate {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("investor_updates")
}

model ClientProfile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  legalEntityName      String?
  registeredAddress    String?
  taxId                String?
  industryDomain       String?
  jurisdiction         String?
  dataResidency        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  billingContactEmail  String?
  billingContactName   String?
  billingContactPhone  String?
  escalationMatrix     Json?
  interestedServices   String[]
  governanceRules      String?
  rulesAcknowledgedAt  DateTime?
  rulesAcknowledgedBy  String?
  rulesLastUpdated     DateTime?
  governanceApprovedAt DateTime?
  governanceApprovedBy String?
  governanceRationale  String?
  authorityMatrix      AuthorityRole[]
  user                 User            @relation("ClientProfileOwner", fields: [userId], references: [id])
}

model AuthorityRole {
  id               String        @id @default(cuid())
  clientProfileId  String
  roleName         String
  name             String
  email            String?
  canApproveBudget Boolean       @default(false)
  canApproveScope  Boolean       @default(false)
  canApproveGoLive Boolean       @default(false)
  signingLimit     Decimal?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  clientProfile    ClientProfile @relation(fields: [clientProfileId], references: [id])
}

model BusinessObjective {
  id          String   @id @default(cuid())
  projectId   String
  description String
  type        String
  kpiMetric   String?
  status      String   @default("ON_TRACK")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id])
}

model AccountabilityEvent {
  id                String                     @id @default(cuid())
  eventType         String
  eventCategory     String
  projectId         String
  clientId          String
  userId            String
  decisionId        String?
  riskId            String?
  changeRequestId   String?
  deliverableId     String?
  actionTaken       String
  impactSummary     String?
  commitmentNote    String?
  ipAddress         String?
  eventTimestamp    DateTime                   @default(now())
  actorRole         ActorRole?
  eventSource       EventSource?
  relatedEntityId   String?
  relatedEntityType RelatedEntityType?
  summary           String?
  changeRequest     ChangeRequest?             @relation(fields: [changeRequestId], references: [id])
  client            User                       @relation("ClientAccountability", fields: [clientId], references: [id])
  decision          Decision?                  @relation(fields: [decisionId], references: [id])
  deliverable       Deliverable?               @relation(fields: [deliverableId], references: [id])
  project           Project                    @relation(fields: [projectId], references: [id])
  risk              Risk?                      @relation(fields: [riskId], references: [id])
  user              User                       @relation("UserAccountability", fields: [userId], references: [id])
  impacts           AccountabilityImpact[]     @relation("EventImpacts")
  obligations       AccountabilityObligation[] @relation("EventObligations")

  @@index([projectId, eventTimestamp])
  @@index([clientId, eventTimestamp])
  @@index([eventType])
  @@map("accountability_events")
}

model AccountabilityObligation {
  id             String              @id @default(cuid())
  clientId       String
  projectId      String
  obligationType ObligationType
  owedByRole     ActorRole
  owedByUserId   String?
  description    String
  dueDate        DateTime?
  status         ObligationStatus    @default(OPEN)
  linkedEventId  String
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  client         User                @relation("ClientObligations", fields: [clientId], references: [id])
  linkedEvent    AccountabilityEvent @relation("EventObligations", fields: [linkedEventId], references: [id])
  owedByUser     User?               @relation("UserObligations", fields: [owedByUserId], references: [id])
  project        Project             @relation("ProjectObligations", fields: [projectId], references: [id])

  @@index([clientId, status])
  @@index([projectId, status])
  @@index([owedByRole, status])
  @@index([linkedEventId])
  @@map("accountability_obligations")
}

model AccountabilityImpact {
  id          String              @id @default(cuid())
  eventId     String
  impactType  ImpactType
  impactValue Decimal             @db.Decimal(12, 2)
  impactUnit  ImpactUnit
  appliedTo   ImpactDomain
  createdAt   DateTime            @default(now())
  event       AccountabilityEvent @relation("EventImpacts", fields: [eventId], references: [id])

  @@index([eventId])
  @@index([appliedTo])
  @@map("accountability_impacts")
}

model AccountabilitySnapshot {
  id                 String   @id @default(cuid())
  clientId           String
  projectId          String
  snapshotDate       DateTime @db.Date
  clientDelayDays    Int      @default(0)
  adminDelayDays     Int      @default(0)
  externalDelayDays  Int      @default(0)
  budgetClientCaused Decimal  @default(0) @db.Decimal(12, 2)
  budgetAdminCaused  Decimal  @default(0) @db.Decimal(12, 2)
  riskScore          Decimal  @default(0) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  client             User     @relation("ClientSnapshots", fields: [clientId], references: [id])
  project            Project  @relation("ProjectSnapshots", fields: [projectId], references: [id])

  @@unique([projectId, snapshotDate])
  @@index([clientId, snapshotDate])
  @@map("accountability_snapshots")
}

model ServiceLine {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  leadId      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  metrics     PracticeMetric[]
  lead        User?            @relation(fields: [leadId], references: [id])
  projects    Project[]        @relation("ProjectToServiceLine")

  @@map("service_lines")
}

model PracticeMetric {
  id            String      @id @default(cuid())
  serviceLineId String
  period        DateTime
  revenue       Decimal     @db.Decimal(12, 2)
  cost          Decimal     @db.Decimal(12, 2)
  margin        Decimal     @db.Decimal(5, 2)
  utilization   Decimal     @db.Decimal(5, 2)
  headcount     Int
  bench         Int
