  recommendationId String
  objective        String
  impact           Int
  urgency          Int
  confidence       Int
  priority         Int
  businessValue    Int?
  engineVersion    String
  schemaVersion    String
  createdAt        DateTime @default(now())

  @@index([recommendationId])
  @@index([objective])
  @@index([createdAt])
  @@map("hcip_recommendation_history")
