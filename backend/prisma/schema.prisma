  investor                User?           @relation("InvestorEmails", fields: [investorId], references: [id])
  jobSeeker               User?           @relation("JobSeekerEmails", fields: [jobSeekerId], references: [id])
  partner                 User?           @relation("PartnerEmails", fields: [partnerId], references: [id])
  triggeredRisks          Risk[]          @relation("RiskFromEmail")

  @@index([threadId])
  @@index([partnerId])
  @@index([clientId])
  @@index([investorId])
  @@index([jobSeekerId])
  @@map("email_logs")
}

// ── Cap Table & Fundraising ───────────────────────────────────────────────────

model CapTableEntry {
  id              String   @id @default(cuid())
  investorName    String
  firm            String
  round           String   // pre-seed|seed|series-a|series-b|growth|bridge
  amount          Float    @default(0)   // £k invested
  ownership       Float    @default(0)   // % equity
  shareClass      String   @default("Ordinary")
  date            DateTime
  proRataRights   Boolean  @default(false)
  boardSeat       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("cap_table_entries")
}

model FundraisingRound {
  id              String   @id @default(cuid())
  name            String
  stage           String   // pre-seed|seed|series-a|series-b|growth|bridge
  targetAmount    Float    @default(0)   // £k
  raisedAmount    Float    @default(0)   // £k
  status          String   @default("planning") // planning|open|closing|closed
  openDate        DateTime
  closeDate       DateTime?
  leadInvestorName String?
  investorNames   String[]
  valuation       Float    @default(0)   // £k post-money
  useOfFunds      Json     @default("[]") // { category, amount, percentage }[]
