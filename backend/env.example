# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kangqore_core"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Python Intelligence Layer
PYTHON_SERVICE_URL=http://localhost:8000

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# eQORE AI Concierge
ANTHROPIC_API_KEY=sk-ant-...
CONCIERGE_MODEL=claude-sonnet-4-5
CONCIERGE_MAX_OUTPUT_TOKENS=600
CONCIERGE_DAILY_TOKEN_BUDGET=2000000
CONCIERGE_RATE_LIMIT_POINTS=20
CONCIERGE_RATE_LIMIT_DURATION=300
CONCIERGE_BURST_POINTS=5
CONCIERGE_BURST_DURATION=60
CONCIERGE_LEAD_POINTS=5
CONCIERGE_LEAD_DURATION=600

# Phase 2 (vector DB / embeddings)
VOYAGE_API_KEY=
